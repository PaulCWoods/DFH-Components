---
import Icon from './Icon.astro';

interface Props {
  title: string;
  category: string;
  categoryHref?: string;
  type?: 'Atom' | 'Molecule' | 'Organism' | 'Layout' | 'Utility';
  wcagLevel?: 'AAA' | 'AA';
  status?: string;
  description: string;
  sourcePath?: string;
  storybookPath?: string;
}

const {
  title,
  category,
  categoryHref = '/components',
  type = 'Atom',
  wcagLevel = 'AAA',
  status = 'Stable v2.2',
  description,
  sourcePath = 'src/atoms/button.css',
  storybookPath = 'atoms-button--docs',
} = Astro.props;
---

<header class="component-header prose-end mb-xl prose">
  <!-- Breadcrumbs -->
  <nav class="breadcrumb mb-md prose-end" aria-label="Breadcrumbs">
    <ol class="small-text">
      <li><a href="/" class="link">Docs</a></li>
      <li><a href="/components" class="link">Components</a></li>
      <li><a href={categoryHref} class="link">{category}</a></li>
      <li aria-current="page">{title}</li>
    </ol>
  </nav>

  <!-- Title & Prominence Badges -->
  <div class="split split--end mb-md">
    <div class="stack">
      <h1 class="title m-0">{title}</h1>
      <div class="inline gap-sm">
      <span class="chip chip--sm">
        <span class="chip__text">{type}</span>
      </span>
      <span class="status status--success status--subtle status--sm">
        <span class="status__text">WCAG {wcagLevel}</span>
      </span>
      <span class="status status--subtle status--sm">
        <span class="status__text">{status}</span>
      </span>
      </div>
    </div>

    <!-- Quick External Action Links -->
    <div class="inline gap-xs">
      <a
        href={`http://localhost:6006/?path=/docs/${storybookPath}`}
        target="_blank"
        rel="noopener noreferrer"
        class="button button--subtle button--sm"
        title="Open interactive sandbox in Storybook"
      >
        <Icon name="BrandStorybook" size={14} />
        <span>Storybook</span>
        <Icon name="ArrowUpRight" size={12} class="text-muted" />
      </a>
      <a
        href={`https://github.com/PaulCWoods/DFH-Components/tree/main/packages/css/${sourcePath}`}
        target="_blank"
        rel="noopener noreferrer"
        class="button button--subtle button--sm"
        title="View source on GitHub"
      >
        <Icon name="BrandGithub" size={14} />
        <span>Source</span>
        <Icon name="ArrowUpRight" size={12} class="text-muted" />
      </a>
    </div>
  </div>
  <!-- Lede Paragraph -->
  <p class="lede text-muted mb-md">
    {description}
  </p>

  <!-- Spec Strip / Quick Facts -->
  <dl class="grid grid--sm gap-lg my-lg spec-strip">
    <div class="lockup gap-sm">
      <dt class="micro-heading">CSS Source</dt>
      <dd class="small-text"><code>packages/css/{sourcePath}</code></dd>
    </div>
    <div class="lockup gap-sm">
      <dt class="micro-heading">Default Touch Target</dt>
      <dd class="small-text">48 × 48 px (WCAG 2.5.5 AAA)</dd>
    </div>
    <div class="lockup gap-sm">
      <dt class="micro-heading">Cascade Specificity</dt>
      <dd class="small-text"><code>:where(.button)</code> (0, 0, 0)</dd>
    </div>
    <div class="lockup gap-sm">
      <dt class="micro-heading">Container Queries</dt>
      <dd class="small-text"><code>--ui-sizing</code>, <code>--button-prominence</code>, <code>--button-intent</code></dd>
    </div>
  </dl>
</header>

<style>
  .component-header {
    padding-block-end: var(--spacing-16, 1rem);
    border-block-end: 1px solid var(--border-color-quiet, currentColor);
  }

  .spec-item {
    padding: var(--spacing-8);
    border: var(--border-subtle);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-2, 0.125rem);
  }

  .spec-label {
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 0.7rem;
  }

  .spec-value {
    font-size: var(--typography-font-size--1, 0.875rem);
  }
</style>
