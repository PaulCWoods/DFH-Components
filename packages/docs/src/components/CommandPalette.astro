---
import Icon from './Icon.astro';

/* Same markup as the Command Palette recipe: the card is the combobox, its
   header holds the control and its body the static list (§28 D). */
const searchIndex = [
  { title: 'Button', desc: 'Actions, with prominence, intent and size', href: '/components/atoms/button', category: 'Atoms', icon: 'Point' },
  { title: 'Badge, status and chip', desc: 'Counts, states and removable values', href: '/components/atoms/badge', category: 'Atoms', icon: 'Bookmark' },
  { title: 'Form controls', desc: 'Inputs, selects, textareas, checkboxes and switches', href: '/components/atoms/input', category: 'Atoms', icon: 'Edit' },
  { title: 'Text', desc: 'Headings and body text at each step of the scale', href: '/components/atoms/text', category: 'Atoms', icon: 'List' },
  { title: 'Accordion', desc: 'Disclosures built on details and summary', href: '/components/molecules/accordion', category: 'Molecules', icon: 'ChevronDown' },
  { title: 'Card', desc: 'A surface with header, body and footer', href: '/components/molecules/card', category: 'Molecules', icon: 'Grid' },
  { title: 'Combobox', desc: 'A field that filters a list', href: '/components/molecules/combobox', category: 'Molecules', icon: 'Search' },
  { title: 'Menu', desc: 'Lists of actions in a popover or panel', href: '/components/molecules/menu', category: 'Molecules', icon: 'List' },
  { title: 'Dialog', desc: 'Modal panels and drawers', href: '/components/organisms/dialog', category: 'Organisms', icon: 'Expand' },
  { title: 'Table', desc: 'Data with sorting, selection and sticky parts', href: '/components/organisms/table', category: 'Organisms', icon: 'Grid' },
  { title: 'Tabs', desc: 'Tab lists and tabbed content', href: '/components/organisms/tabs', category: 'Organisms', icon: 'SortableHorizontal' },
  { title: 'Tokens', desc: 'Global, semantic and component tiers', href: '/tokens', category: 'Guides', icon: 'Disc' },
  { title: 'Accessibility', desc: 'WCAG 2.2 rules, target sizes and contrast', href: '/getting-started/accessibility', category: 'Guides', icon: 'Circle' },
];

const slug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-');
const categories = [...new Set(searchIndex.map((i) => i.category))];
---

<dialog id="cmd-palette" class="dialog" aria-label="Search" closedby="any">
  <div class="card card--ruled combobox combobox--plain">
    <header class="card__header">
      <div class="combobox__control">
        <Icon name="Search" class="combobox__icon-start" />
        <input
          id="cmd-input"
          type="search"
          class="combobox__input"
          role="combobox"
          aria-label="Search"
          aria-expanded="true"
          aria-autocomplete="list"
          aria-controls="cmd-listbox"
          placeholder="Search components and guides"
          autocomplete="off"
          spellcheck="false"
        />
        <button type="button" class="button button--plain button--icon" commandfor="cmd-palette" command="close">
          <span class="sr-only">Close</span>
          <Icon name="Close" />
        </button>
      </div>
    </header>

    <div class="card__body card__body--scrollable" tabindex="0" aria-label="Results">
      <div id="cmd-listbox" class="combobox__listbox combobox__listbox--static" role="listbox" aria-label="Results">
        {categories.map((cat) => (
          <ul role="group" aria-labelledby={`cmd-g-${slug(cat)}`}>
            <li id={`cmd-g-${slug(cat)}`} role="presentation" class="combobox__group-label micro-heading">{cat}</li>
            {searchIndex.filter((i) => i.category === cat).map((item) => (
              <li
                role="option"
                id={`cmd-opt-${slug(item.title)}`}
                class="combobox__option"
                aria-selected="false"
                data-href={item.href}
              >
                <Icon name={item.icon} class="text-muted" />
                <span class="lockup grow">
                  <span class="small-heading">{item.title}</span>
                  <span class="small-text text-muted">{item.desc}</span>
                </span>
              </li>
            ))}
          </ul>
        ))}
      </div>
      <div id="cmd-empty" class="empty-state empty-state--compact" hidden>
        <div class="empty-state__content">
          <h2 class="empty-state__title small-heading">Nothing matches</h2>
          <p class="empty-state__description small-text">Try a component name, such as “button” or “dialog”.</p>
        </div>
      </div>
      <p id="cmd-status" class="sr-only" role="status"></p>
    </div>

    <footer class="card__footer cluster small-text text-muted">
      <span><kbd class="kbd">↑</kbd> <kbd class="kbd">↓</kbd> to move</span>
      <span><kbd class="kbd">↵</kbd> to choose</span>
      <span><kbd class="kbd">Esc</kbd> to close</span>
    </footer>
  </div>
</dialog>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const dialog = document.getElementById('cmd-palette');
    const input = document.getElementById('cmd-input');
    const listbox = document.getElementById('cmd-listbox');
    const empty = document.getElementById('cmd-empty');
    const status = document.getElementById('cmd-status');
    const searchBtn = document.getElementById('header-search-btn');
    if (!dialog || !input || !listbox) return;

    const options = Array.from(listbox.querySelectorAll('[role="option"]'));
    const visible = () => options.filter((o) => !o.hidden);

    const setActive = (o) => {
      options.forEach((x) => x.classList.toggle('is-active', x === o));
      if (o) {
        input.setAttribute('aria-activedescendant', o.id);
        o.scrollIntoView({ block: 'nearest' });
      } else {
        input.removeAttribute('aria-activedescendant');
      }
    };

    const filter = () => {
      const q = input.value.trim().toLowerCase();
      options.forEach((o) => (o.hidden = !!q && !o.textContent.toLowerCase().includes(q)));
      listbox.querySelectorAll('[role="group"]').forEach((g) => (g.hidden = !g.querySelector('[role="option"]:not([hidden])')));
      const n = visible().length;
      if (empty) empty.hidden = n > 0;
      if (status) status.textContent = q ? (n ? `${n} result${n === 1 ? '' : 's'}` : 'No results') : '';
      setActive(visible()[0] || null);
    };

    const go = (o) => {
      const href = o && o.dataset.href;
      dialog.close();
      if (href) window.location.href = href;
    };

    const open = () => {
      input.value = '';
      filter();
      dialog.showModal();
      input.focus();
    };

    window.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        if (dialog.open) dialog.close();
        else open();
      }
    });
    if (searchBtn) searchBtn.addEventListener('click', open);

    input.addEventListener('input', filter);
    input.addEventListener('keydown', (e) => {
      const v = visible();
      const cur = v.findIndex((o) => o.classList.contains('is-active'));
      if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
        e.preventDefault();
        if (!v.length) return;
        const step = e.key === 'ArrowDown' ? 1 : -1;
        setActive(v[(cur + step + v.length) % v.length]);
      } else if (e.key === 'Enter' && cur > -1) {
        e.preventDefault();
        go(v[cur]);
      }
    });
    options.forEach((o) => {
      o.addEventListener('mousedown', (e) => e.preventDefault());
      o.addEventListener('click', () => go(o));
    });
  });
</script>
