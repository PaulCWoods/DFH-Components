---
/* Previous and next pages, in reading order */
import Icon from './Icon.astro';
import type { Page } from '../lib/nav';
interface Props { prev?: Page; next?: Page }
const { prev, next } = Astro.props;
---
{(prev || next) && (
  <nav class="grid grid--2-col gap-sm" aria-label="Previous and next">
    {prev ? (
      <a href={prev.href} class="block-link block-link--subtle" rel="prev">
        <span class="block-link__text"><span class="small-text text-muted">Previous</span><br />{prev.title}</span>
      </a>
    ) : <span />}
    {next && (
      <a href={next.href} class="block-link block-link--subtle" rel="next">
        <span class="block-link__text"><span class="small-text text-muted">Next</span><br />{next.title}</span>
        <Icon name="arrow-right" class="block-link__arrow icon--dir" />
      </a>
    )}
  </nav>
)}
