---
/* ==========================================================================
   The site header (§33): the brand, the sections as a tab list, search,
   the colour scheme, and below 48rem a menu button for the drawer, which
   holds the sections and the colour scheme.
   ========================================================================== */
import Icon from './Icon.astro';
import NavTree from './NavTree.astro';
import SchemeToggle from './SchemeToggle.astro';
import type { Section } from '../lib/nav';

interface Props { nav: Section[]; current: string }
const { nav, current } = Astro.props;
const inSection = (s: Section) => s.pages.some((p) => p.href === current);
---
<header class="header header--sticky">
  <div class="header__bar">
    <a href="/" class="link link--plain small-heading inline gap-xs">
      <Icon name="BrandDesignForHumans" /><span>Design For Humans</span>
    </a>
    <nav class="header__nav tab-list tab-list--plain tab-list--scrollable @max-3xl:hide" aria-label="Sections">
      <ul>
        {nav.map((s) => (
          <li><a href={s.href} class="tab" aria-current={inSection(s) ? 'page' : undefined}><span class="tab__text">{s.label}</span></a></li>
        ))}
      </ul>
    </nav>
    <div class="cluster gap-xs">
      <button type="button" class="button button--plain button--icon" commandfor="search" command="show-modal">
        <Icon name="Search" /><span class="sr-only">Search</span>
      </button>
      <SchemeToggle class="@max-3xl:hide" />
      <button type="button" class="button button--plain button--icon @3xl:hide" commandfor="site-nav" command="show-modal">
        <Icon name="Navigation" /><span class="sr-only">Menu</span>
      </button>
    </div>
  </div>
</header>

<dialog id="site-nav" class="dialog dialog--drawer dialog--start" aria-labelledby="drawer-title" closedby="any">
  <article class="card">
    <header class="card__header">
      <h2 id="drawer-title" class="card__title small-heading">Menu</h2>
      <button type="button" class="button button--plain button--icon" commandfor="site-nav" command="close">
        <span class="sr-only">Close</span><Icon name="Close" />
      </button>
    </header>
    <div class="card__body card__body--scrollable" tabindex="0" aria-label="Menu">
      <NavTree nav={nav} current={current} mode="all" idPrefix="drawer-nav" />
    </div>
    <footer class="card__footer">
      <span class="small-text" aria-hidden="true">Colour scheme</span>
      <SchemeToggle />
    </footer>
  </article>
</dialog>
