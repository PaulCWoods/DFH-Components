---
import Icon from './Icon.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  currentSection?: string;
}

const { currentSection = '' } = Astro.props;
---

<header class="header header--sticky header--translucent" style="--header-max-width: none;">
  <div class="header__bar">
    
    <!-- Left: Brand Lockup & Mobile Toggle -->
    <div class="inline">
      <button
        type="button"
        class="button button--plain button--icon md:hide"
        commandfor="docs-nav"
        command="show-modal"
        aria-haspopup="dialog"
      >
        <span class="sr-only">Navigation menu</span>
        <Icon name="Navigation" />
      </button>

      <div class="inline relative">
        <Icon name="BrandDesignForHumans" class="text-accent" size={"2xl"} />
        <div class="lockup whitespace-nowrap max-sm:hide">
          <span class="small-heading">
            <a href="/" class="link link--plain link--stretched">
              Design For Humans
            </a>
          </span>
          <span class="small-text text-muted">v2.2 • Accessible UI Library</span>
        </div>
      </div>

      <span class="status status--accent status--subtle status--sm max-md:hide">
        <span class="status__text">WCAG AAA</span>
      </span>
    </div>

    <!-- Center: Primary Nav Links (Tab List Navigation Pattern) -->
    <nav class="header__nav tab-list tab-list--plain tab-list--scrollable max-xl:hide" aria-label="Main Navigation">
      <ul>
        <li>
          <a
            href="/"
            class="tab"
            aria-current={currentSection === 'overview' ? 'page' : undefined}
          >
            <span class="tab__text">Overview</span>
          </a>
        </li>
        <li>
          <a
            href="/components"
            class="tab"
            aria-current={currentSection === 'components' ? 'page' : undefined}
          >
            <span class="tab__text">Components</span>
          </a>
        </li>
        <li>
          <a
            href="/tokens"
            class="tab"
            aria-current={currentSection === 'tokens' ? 'page' : undefined}
          >
            <span class="tab__text">Tokens</span>
          </a>
        </li>
        <li>
          <a
            href="/guidelines"
            class="tab"
            aria-current={currentSection === 'guidelines' ? 'page' : undefined}
          >
            <span class="tab__text">Guidelines</span>
          </a>
        </li>
      </ul>
    </nav>

    <!-- Right: Quick Search, Theme Toggle, Storybook Link -->
    <div class="inline gap-xs">
      <button
        type="button"
        id="header-search-btn"
        class="button button--subtle"
        aria-label="Search documentation (Cmd+K)"
        title="Search documentation (Cmd+K)"
      >
        <Icon name="Search" size={16} />
        <span class="max-sm:hide text-muted">Search...</span>
        <kbd class="kbd max-sm:hide">⌘K</kbd>
      </button>

      <ThemeToggle />

      <a
        href="http://localhost:6006"
        target="_blank"
        rel="noopener noreferrer"
        class="button button--plain button--icon max-sm:hide"
        aria-label="Storybook component explorer (opens in a new tab)"
        title="Open Storybook Sandbox (Port 6006)"
      >
        <Icon name="Code" size={20} />
      </a>
    </div>

  </div>
</header>
