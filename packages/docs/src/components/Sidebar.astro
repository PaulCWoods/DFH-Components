---
import Icon from './Icon.astro';

interface Props {
  currentPath?: string;
  currentSection?: string;
}

const { currentSection = '' } = Astro.props;
const { currentPath = '' } = Astro.props;

const navSections = [
  {
    title: 'Getting Started',
    items: [
      { label: 'Introduction', href: '/' },
      { label: 'Composition Law', href: '/getting-started/composition-law', badge: 'Rule' },
      { label: 'Accessibility (WCAG 2.2)', href: '/getting-started/accessibility', badge: 'AAA' },
    ],
  },
  {
    title: 'Design Tokens',
    items: [
      { label: 'Token Architecture', href: '/tokens' },
      { label: 'Colors & Palettes', href: '/tokens#colors' },
      { label: 'Typography Scale', href: '/tokens#typography' },
      { label: 'Spacing & Elevation', href: '/tokens#surfaces' },
    ],
  },
  {
    title: 'Layout Primitives',
    items: [
      { label: 'App Shell (.app)', href: '/components/layout/app' },
      { label: 'Sidebar (.sidebar)', href: '/components/layout/sidebar', badge: 'New' },
      { label: 'Split (.split)', href: '/components/layout/split' },
      { label: 'Grid (.grid)', href: '/components/layout/grid' },
      { label: 'Cluster & Stack', href: '/components/layout/cluster' },
    ],
  },
  {
    title: 'Atoms',
    items: [
      { label: 'Button', href: '/components/atoms/button', badge: 'Core' },
      { label: 'Tab Primitive', href: '/components/atoms/tab', badge: 'Updated' },
      { label: 'Badge & Chip', href: '/components/atoms/badge' },
      { label: 'Input & Textarea', href: '/components/atoms/input' },
      { label: 'Select & Switch', href: '/components/atoms/switch' },
      { label: 'Typography Atoms', href: '/components/atoms/text' },
    ],
  },
  {
    title: 'Molecules',
    items: [
      { label: 'Tab List (Navigation)', href: '/components/molecules/tab-list', badge: 'New' },
      { label: 'Field & Fieldset', href: '/components/molecules/field' },
      { label: 'Button Group', href: '/components/molecules/button-group' },
      { label: 'Banner & Alert', href: '/components/molecules/banner' },
      { label: 'Popover & Tooltip', href: '/components/molecules/popover' },
      { label: 'Batch Actions', href: '/components/molecules/batch-actions' },
      { label: 'Telemetry & Stepper', href: '/components/molecules/telemetry' },
    ],
  },
  {
    title: 'Organisms',
    items: [
      { label: 'Card & Deck', href: '/components/organisms/card' },
      { label: 'Dialog (Native Modal)', href: '/components/organisms/dialog', badge: 'HTML5' },
      { label: 'Menu & Context Menu', href: '/components/organisms/menu' },
      { label: 'Combobox & Listbox', href: '/components/organisms/combobox' },
      { label: 'Accordion Disclosures', href: '/components/organisms/accordion' },
      { label: 'Table', href: '/components/organisms/table' },
      { label: 'Tabs Organism', href: '/components/organisms/tabs' },
      { label: 'Header Landmark', href: '/components/organisms/header' },
    ],
  },
  {
    title: 'Composite Recipes',
    items: [
      { label: 'Command Palette', href: '/recipes/command-palette', badge: 'Cmd+K' },
      { label: 'Cadence Dashboard', href: '/recipes/cadence-dashboard' },
      { label: 'Filter Sidebar', href: '/recipes/filter-sidebar' },
    ],
  },
];
---

<aside id="docs-sidebar" class="sidebar sidebar--flush sidebar--sticky sidebar--ruled" aria-label="Documentation Navigation">
  
  <!-- Mobile Header (Visible on viewports < 48em) -->
  <header class="sidebar__header max-md:show">
    <span class="subheading text-muted">Explore</span>
    <button
      type="button"
      id="mobile-nav-close"
      class="button button--plain button--icon button--sm"
      aria-label="Close navigation menu"
    >
      <Icon name="Close" size={16} />
    </button>
  </header>

  <div class="sidebar__band xl:hide">
  <nav class="tab-list tab-list--segmented tab-list--fill tab-list--sm tab-list--subtle" aria-label="Main Navigation">
      <ul>
        <li>
          <a
            href="/"
            class="tab"
            aria-current={currentSection === 'overview' ? 'page' : undefined}
          >
            <span class="tab__text">Overview</span>
          </a>
        </li>
        <li>
          <a
            href="/components"
            class="tab"
            aria-current={currentSection === 'components' ? 'page' : undefined}
          >
            <span class="tab__text">Components</span>
          </a>
        </li>
        <li>
          <a
            href="/tokens"
            class="tab"
            aria-current={currentSection === 'tokens' ? 'page' : undefined}
          >
            <span class="tab__text">Tokens</span>
          </a>
        </li>
        <li>
          <a
            href="/guidelines"
            class="tab"
            aria-current={currentSection === 'guidelines' ? 'page' : undefined}
          >
            <span class="tab__text">Guidelines</span>
          </a>
        </li>
      </ul>
    </nav>
  </div>

  <!-- Dedicated Scroll Container (.sidebar__scroller) -->
  <div class="sidebar__scroller py">
    <nav class="tab-list tab-list--flush tab-list--tight tab-list--sm tab-list--segmented tab-list--plain tab-list--vertical overflow-visible" aria-label="Documentation Sections">
      <ul>
        {navSections.map((section, idx) => {
          const sectionId = `nav-sec-${idx}`;
          return (
            <li class="margin-bottom">
              <button
                type="button"
                class="button button--plain button--sm button--icon nav-section-toggle"
                aria-expanded="true"
                aria-controls={sectionId}
              >
                <span class="visually-hidden">Toggle {section.title}</span>
                <Icon name="ChevronDown" size={16} class="icon--disclosure" />
              </button>
              <span class="tab-list__content micro-heading">{section.title}</span>
              <ul id={sectionId}>
                {section.items.map((item) => {
                  const isActive = currentPath === item.href;
                  return (
                    <li>
                      <a
                        href={item.href}
                        class="tab"
                        aria-current={isActive ? 'page' : undefined}
                      >
                        <span class="tab__text">{item.label}</span>
                        {item.badge && (
                          <span class:list={['status', 'status--sm', isActive ? 'status--accent' : 'status--subtle']}>
                            <span class="status__text">{item.badge}</span>
                          </span>
                        )}
                      </a>
                    </li>
                  );
                })}
              </ul>
            </li>
          );
        })}
      </ul>
    </nav>
  </div>

</aside>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    // Mobile Drawer Open / Close
    const sidebar = document.getElementById('docs-sidebar');
    const openBtn = document.getElementById('mobile-nav-toggle');
    const closeBtn = document.getElementById('mobile-nav-close');

    if (openBtn && sidebar) {
      openBtn.addEventListener('click', () => {
        sidebar.classList.add('is-open');
        openBtn.setAttribute('aria-expanded', 'true');
      });
    }

    if (closeBtn && sidebar) {
      closeBtn.addEventListener('click', () => {
        sidebar.classList.remove('is-open');
        if (openBtn) openBtn.setAttribute('aria-expanded', 'false');
      });
    }

    // Collapsible Navigation Sections
    const toggleButtons = document.querySelectorAll('.nav-section-toggle');
    toggleButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetId = btn.getAttribute('aria-controls');
        const targetList = document.getElementById(targetId);
        const isExpanded = btn.getAttribute('aria-expanded') === 'true';

        btn.setAttribute('aria-expanded', isExpanded ? 'false' : 'true');
        if (targetList) {
          targetList.hidden = isExpanded;
        }
      });
    });
  });
</script>
