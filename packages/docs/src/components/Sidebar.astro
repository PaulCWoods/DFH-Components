---
import Icon from './Icon.astro';
import SidebarNav from './SidebarNav.astro';

interface Props {
  currentPath?: string;
  currentSection?: string;
}

const { currentSection = '', currentPath = '' } = Astro.props;
---

<!-- Wide screens: a sticky sidebar beside the content -->
<aside id="docs-sidebar" class="sidebar sidebar--sticky sidebar--ruled max-md:hide" aria-label="Documentation">
  <div class="sidebar__band xl:hide">
    <nav class="tab-list tab-list--segmented tab-list--fill tab-list--sm tab-list--subtle" aria-label="Main Navigation">
        <ul>
          <li>
            <a
              href="/"
              class="tab"
              aria-current={currentSection === 'overview' ? 'page' : undefined}
            >
              <span class="tab__text">Overview</span>
            </a>
          </li>
          <li>
            <a
              href="/components"
              class="tab"
              aria-current={currentSection === 'components' ? 'page' : undefined}
            >
              <span class="tab__text">Components</span>
            </a>
          </li>
          <li>
            <a
              href="/tokens"
              class="tab"
              aria-current={currentSection === 'tokens' ? 'page' : undefined}
            >
              <span class="tab__text">Tokens</span>
            </a>
          </li>
          <li>
            <a
              href="/guidelines"
              class="tab"
              aria-current={currentSection === 'guidelines' ? 'page' : undefined}
            >
              <span class="tab__text">Guidelines</span>
            </a>
          </li>
        </ul>
      </nav>
  </div>
  <div class="sidebar__body sidebar__body--flush">
    <SidebarNav currentPath={currentPath} currentSection={currentSection} prefix="side" />
  </div>
</aside>

<!-- Small screens: the same navigation in a drawer, opened from the header -->
<dialog id="docs-nav" class="dialog dialog--drawer dialog--start" aria-labelledby="docs-nav-title">
  <article class="card">
    <header class="card__header">
      <h2 id="docs-nav-title" class="card__title small-heading">Explore</h2>
      <button type="button" class="button button--plain button--icon" commandfor="docs-nav" command="close">
          <span class="sr-only">Close navigation</span>
          <Icon name="Close" />
        </button>
    </header>
    <div class="card__body card__body--scrollable stack">
      <SidebarNav currentPath={currentPath} currentSection={currentSection} prefix="drawer" withMain />
    </div>
  </article>
</dialog>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    // Collapsible Navigation Sections
    document.querySelectorAll('.nav-section-toggle').forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetList = document.getElementById(btn.getAttribute('aria-controls'));
        const isExpanded = btn.getAttribute('aria-expanded') === 'true';

        btn.setAttribute('aria-expanded', isExpanded ? 'false' : 'true');
        if (targetList) {
          targetList.hidden = isExpanded;
        }
      });
    });
  });
</script>
