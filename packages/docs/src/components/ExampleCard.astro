---
interface Props {
  title: string;
  subtitle?: string;
  code?: string;
  badge?: string;
  badgeTone?: 'accent' | 'success' | 'warning' | 'danger' | 'subtle';
  description?: string;
  class?: string;
  previewClass?: string;
  minHeight?: string;
}

const {
  title,
  subtitle,
  code,
  badge,
  badgeTone = 'accent',
  description,
  class: className = '',
  previewClass = '',
  minHeight,
} = Astro.props;
---

<article class:list={['card card--compact example-card', className]}>
  <div class="card__body card__body--flush">
    <div
      class:list={['preview-stage', previewClass]}
      style={minHeight ? { minBlockSize: minHeight } : undefined}
    >
      <slot />
    </div>
  </div>
    <header class="card__header inline inline--between">
      <div class="card__hgroup">
        <h3 class="small-heading m-0">{title}</h3>
        {subtitle && <p class="card__subtitle small-text text-muted m-0">{subtitle}</p>}
      </div>
      <div class="inline gap-xs">
        {code && <code class="small-text">{code}</code>}
        {badge && (
          <span class:list={['status status--sm', `status--${badgeTone}`]}>
            <span class="status__text">{badge}</span>
          </span>
        )}
        <slot name="meta" />
      </div>
    </header>
    <div class="card__body">
      {description ? (
        <p class="text-muted small-text m-0">{description}</p>
      ) : (
        <slot name="description" />
      )}
      <slot name="body" />
    </div>
</article>

<style>
  .example-card {
    height: 100%;
  }

  .preview-stage {
    min-block-size: 4.5rem;
    padding: var(--spacing-16, 1rem);
    background-color: var(--surface-subtle, #f8fafc);
    border-radius: var(--radius-sm, 0.25rem);
    display: flex;
    align-items: center;
    justify-content: center;
  }
</style>
