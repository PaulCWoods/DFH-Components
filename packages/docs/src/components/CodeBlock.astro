---
import Icon from './Icon.astro';

interface Props {
  code: string;
  lang?: string;
  title?: string;
  class?: string;
}

const {
  code,
  lang = 'html',
  title,
  class: className = '',
} = Astro.props;

const cleanCode = code.trim();
---

<div class:list={['code-block prose-end card card--bordered card--compact', className]}>
  <div class="card__content">
    <div class="code-block__header card__header inline inline--between align-items-center">
      <div class="inline align-items-center gap-xs">
        {title ? (
          <span class="micro-heading text-muted">{title}</span>
        ) : (
          <span class="badge badge--sm badge--subtle">
            <span>{lang.toUpperCase()}</span>
          </span>
        )}
      </div>
      <button
        type="button"
        class="button button--plain button--sm code-block__copy"
        aria-label="Copy code to clipboard"
        data-code={cleanCode}
      >
        <Icon name="Duplicate" size={14} class="copy-icon" />
        <Icon name="Check" size={14} class="check-icon hide" />
        <span class="copy-label">Copy</span>
      </button>
    </div>
    <pre class="pre code-block__pre" tabindex="0"><code>{cleanCode}</code></pre>
  </div>
</div>

<style>
  .code-block {
    margin-block: var(--spacing-16, 1rem);
    background-color: var(--surface-subtle, var(--surface, Canvas));
    border-radius: var(--radius-md, 0.5rem);
    overflow: hidden;
  }

  .code-block__header {
    padding-block: var(--spacing-6, 0.375rem);
    padding-inline: var(--spacing-12, 0.75rem);
    background-color: var(--surface-layer, var(--surface-card, transparent));
    border-block-end: 1px solid var(--border-color-quiet, currentColor);
  }

  .code-block__pre {
    margin: 0;
    padding: var(--spacing-16, 1rem);
    overflow-x: auto;
    font-family: var(--typography-code-font-family, 'JetBrains Mono', monospace);
    font-size: var(--typography-font-size--1, 0.875rem);
    line-height: 1.6;
    color: var(--foreground, currentColor);
    background: transparent;
  }

  .code-block__pre code {
    background: transparent;
    padding: 0;
    border: none;
    font-family: inherit;
  }

  .code-block__copy {
    padding-block: var(--spacing-2, 0.125rem);
    padding-inline: var(--spacing-8, 0.5rem);
  }

  .check-icon {
    color: var(--foreground-success, #008060);
  }
</style>

<script is:inline>
  (() => {
    document.addEventListener('click', async (e) => {
      const btn = e.target.closest('.code-block__copy');
      if (!btn) return;

      const code = btn.getAttribute('data-code');
      if (!code) return;

      try {
        await navigator.clipboard.writeText(code);
        const copyIcon = btn.querySelector('.copy-icon');
        const checkIcon = btn.querySelector('.check-icon');
        const label = btn.querySelector('.copy-label');

        if (copyIcon && checkIcon) {
          copyIcon.classList.add('hide');
          checkIcon.classList.remove('hide');
        }
        if (label) label.textContent = 'Copied!';

        setTimeout(() => {
          if (copyIcon && checkIcon) {
            copyIcon.classList.remove('hide');
            checkIcon.classList.add('hide');
          }
          if (label) label.textContent = 'Copy';
        }, 2000);
      } catch (err) {
        console.error('Failed to copy code: ', err);
      }
    });
  })();
</script>
