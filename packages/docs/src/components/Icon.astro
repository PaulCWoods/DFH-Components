---
/* A symbol from the sprite (public/icons.svg, synced from icons/icons.svg),
   decorative: the control or text beside it carries the name. */
interface Props { name: string; class?: string }
const { name, class: cls = '' } = Astro.props;
---
<svg class:list={['icon', cls]} width="1em" height="1em" aria-hidden="true" focusable="false"><use href={`/icons.svg#${name}`} /></svg>
