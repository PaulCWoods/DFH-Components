---
interface Props {
  id?: string;
  title?: string;
  level?: 2 | 3;
  flush?: boolean;
  compact?: boolean;
  plain?: boolean;
  class?: string;
}

const {
  id,
  title,
  level = 2,
  flush = false,
  compact = false,
  plain = false,
  class: className = '',
} = Astro.props;

const HeadingTag = level === 3 ? 'h3' : 'h2';
---

<section
  id={id}
  class:list={[
    'section',
    {
      'section--flush': flush,
      'section--compact': compact,
      'section--plain': plain,
    },
    className,
  ]}
>
  {title && <HeadingTag id={id ? `${id}-heading` : undefined}>{title}</HeadingTag>}
  <slot />
</section>
