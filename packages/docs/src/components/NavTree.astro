---
/* ==========================================================================
   The docs navigation as a navigation tree (§16b).
   - section: the current section's pages, under its name (the sidebar).
   - all: every section, the current one opened to its pages (the drawer).
   Pages with a group (a component's tier) sit under the group's heading.
   Ids are prefixed, so the sidebar and drawer copies don't clash.
   ========================================================================== */
import type { Page, Section } from '../lib/nav';

interface Props { nav: Section[]; current: string; mode: 'section' | 'all'; idPrefix: string }
const { nav, current, mode, idPrefix } = Astro.props;
const section = nav.find((s) => s.pages.some((p) => p.href === current));
const headingId = `${idPrefix}-heading`;

/* Pages as list items, with a heading before each new group */
type Item = { heading: string } | { page: Page };
const items = (pages: Page[]): Item[] =>
  pages.flatMap((p, i) => (p.group && p.group !== pages[i - 1]?.group ? [{ heading: p.group }, { page: p }] : [{ page: p }]));
const groupId = (label: string) => `${idPrefix}-${label.toLowerCase()}`;
---
{mode === 'section' && section && (
  <nav class="navigation-tree" aria-labelledby={headingId}>
    <ol>
      <li class="sr-only"><h2 id={headingId}>{section.label}</h2></li>
      {items(section.pages).map((item) =>
        'heading' in item ? (
          <li class="navigation-tree__heading"><h3 id={groupId(item.heading)} class="heading text-muted">{item.heading}</h3></li>
        ) : (
          <li><a href={item.page.href} class="button" aria-current={item.page.href === current ? 'page' : undefined}><span>{item.page.title}</span></a></li>
        ),
      )}
    </ol>
  </nav>
)}
{mode === 'all' && (
  <nav class="navigation-tree" aria-labelledby={headingId}>
    <ol>
      {nav.map((s) => (
        <li>
          <a href={s.href} class="button" aria-current={s.href === current ? 'page' : undefined}><span>{s.label}</span></a>
          {s === section && s.pages.length > 1 && (
            <ol>
              {items(s.pages.slice(1)).map((item) =>
                'heading' in item ? (
                  <li class="navigation-tree__heading"><h3 id={groupId(item.heading)} class="micro-heading text-muted">{item.heading}</h3></li>
                ) : (
                  <li><a href={item.page.href} class="button" aria-current={item.page.href === current ? 'page' : undefined}><span>{item.page.title}</span></a></li>
                ),
              )}
            </ol>
          )}
        </li>
      ))}
    </ol>
  </nav>
)}
