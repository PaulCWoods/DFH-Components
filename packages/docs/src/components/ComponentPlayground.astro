---
import Icon from './Icon.astro';
---

<div id="button-playground" class="component-playground prose-end card card--ruled my-lg">
<!-- Playground Top Toolbar -->
<header class="card__header playground-toolbar inline inline--between">
  <div class="inline">
    <h3 class="small-heading">Interactive Playground</h3>
    <span class="status status--accent status--sm"><span class="status__text">Live Demo</span></span>
  </div>

  <!-- Surface Background Switcher -->
  <div class="inline gap-2xs surface-switcher" role="group" aria-label="Preview background switcher">
    <button
      type="button"
      class="button button--plain button--sm button--icon surface-btn is-active"
      data-surface="default"
      title="Default Canvas Surface"
      aria-label="Default Canvas Surface"
    >
      <span class="swatch swatch--canvas button__icon"></span>
    </button>
    <button
      type="button"
      class="button button--plain button--sm button--icon surface-btn"
      data-surface="subtle"
      title="Subtle Tinted Surface"
      aria-label="Subtle Tinted Surface"
    >
      <span class="swatch swatch--subtle button__icon"></span>
    </button>
    <button
      type="button"
      class="button button--plain button--sm button--icon surface-btn"
      data-surface="card"
      title="Card Elevated Surface"
      aria-label="Card Elevated Surface"
    >
      <span class="swatch swatch--card button__icon"></span>
    </button>
    <button
      type="button"
      class="button button--plain button--sm button--icon surface-btn"
      data-surface="dark"
      title="Contrast Dark Surface"
      aria-label="Contrast Dark Surface"
    >
      <span class="swatch swatch--dark button__icon"></span>
    </button>
  </div>
</header>

<!-- Live Canvas Stage -->
<div class="card__band">
<div id="playground-stage" class="playground-stage stage--default">
  <div id="stage-target-container" class="stage-target-wrapper">
    <button type="button" id="stage-button" class="button">
      <span id="stage-label">Click Me</span>
    </button>
  </div>

  <!-- Real-time interaction toast -->
  <div id="playground-feedback" class="stage-feedback small-text text-muted" aria-live="polite">
    Interactive preview: Try clicking or pressing <kbd class="kbd">Tab</kbd> + <kbd class="kbd">Space</kbd>
  </div>
</div>
</div>

<!-- Control Controls Area & Code Inspector (2-column on desktop) -->
<div class="playground-body grid grid--sm grid--ruled border-t card__body gap-lg">
  
  <!-- Left: Controls Configuration Form -->
  <div class="playground-controls">
    <h4 class="micro-heading mb-md">Configure Properties</h4>

    <div class="form form--compact form--aligned ui-compact controls-subtle">
      <!-- Prominence Variant -->
      <div class="field">
        <label for="ctrl-prominence" class="field__label label">Prominence</label>
        <select id="ctrl-prominence" class="select">
          <option value="default" selected>Default (Neutral Outline)</option>
          <option value="strong">Strong (.button--strong)</option>
          <option value="subtle">Subtle (.button--subtle)</option>
          <option value="plain">Plain (.button--plain)</option>
          <option value="placeholder">Placeholder (.button--placeholder)</option>
        </select>
      </div>

      <!-- Semantic Tone -->
      <div class="field">
        <label for="ctrl-tone" class="field__label label">Intent</label>
        <select id="ctrl-tone" class="select">
          <option value="neutral" selected>Neutral</option>
          <option value="accent">Accent / Primary (.button--accent)</option>
          <option value="danger">Danger (.button--danger)</option>
        </select>
      </div>

      <!-- Target Size / Density -->
      <div class="field">
        <label for="ctrl-size" class="field__label label">Size & Target Density</label>
        <select id="ctrl-size" class="select">
          <option value="default" selected>Default (48px — WCAG 2.5.5 AAA)</option>
          <option value="sm">Small / Compact (32px — .button--sm)</option>
          <option value="lg">Large (56px — .button--lg)</option>
        </select>
      </div>

      <!-- Corner Geometry -->
      <div class="field">
        <label for="ctrl-corners" class="field__label label">Corner Shape</label>
        <select id="ctrl-corners" class="select">
          <option value="default" selected>Default Rounded</option>
          <option value="pill">Pill (.button--pill)</option>
          <option value="round">Round (.button--round)</option>
        </select>
      </div>

      <!-- Icon Configuration -->
      <div class="field">
        <label for="ctrl-icon" class="field__label label">Icon Accoutrement</label>
        <select id="ctrl-icon" class="select">
          <option value="none" selected>None (Text Only)</option>
          <option value="leading">Leading Icon (+ Add)</option>
          <option value="trailing">Trailing Directional (→ Arrow)</option>
          <option value="icon-only">Icon Only (Search)</option>
        </select>
      </div>

      <!-- Custom Label -->
      <div class="field" id="field-label-text">
        <label for="ctrl-label" class="field__label label">Button Label</label>
        <input type="text" id="ctrl-label" class="input" value="Get Started" />
      </div>

      <!-- Interactive States Toggles -->
      <hr class="divider" />
      <fieldset class="fieldset">
        <legend class="fieldset__legend label">Interactive States</legend>
        <div class="cluster">
          <label class="button">
            <input type="checkbox" id="ctrl-state-active" class="sr-only" />
            <Icon name="Check" size={14} class="icon--on" />
            <Icon name="Circle" size={14} class="icon--off" />
            <span>Active State</span>
          </label>
          <label class="button">
            <input type="checkbox" id="ctrl-state-disabled" class="sr-only" />
            <Icon name="Check" size={14} class="icon--on" />
            <Icon name="Circle" size={14} class="icon--off" />
            <span>Disabled</span>
          </label>
        </div>
      </fieldset>
    </div>
  </div>

  <!-- Right: Generated Code & Snippet Inspector -->
  <div class="playground-code flex flex-col justify-between">
    <div>
      <div class="inline inline--between mb-sm">
        <div class="tab-list tab-list--tight tab-list--sm tab-list--segmented tab-list--subtle" role="tablist">
          <button
            type="button"
            class="tab is-active"
            id="tab-code-html"
            role="tab"
            aria-selected="true"
            aria-controls="panel-code-html"
          >
            <span class="tab__text">HTML Markup</span>
          </button>
          <button
            type="button"
            class="tab"
            id="tab-code-cq"
            role="tab"
            aria-selected="false"
            aria-controls="panel-code-cq"
          >
            <span class="tab__text">Container Style Query</span>
          </button>
        </div>

        <button
          type="button"
          id="playground-copy-btn"
          class="button button--plain button--sm"
          aria-label="Copy generated code"
        >
          <Icon name="Duplicate" size={14} class="copy-icon" />
          <Icon name="Check" size={14} class="check-icon hidden" />
          <span class="copy-label">Copy</span>
        </button>
      </div>

      <!-- HTML Panel -->
      <div id="panel-code-html" role="tabpanel" aria-labelledby="tab-code-html">
        <pre class="whitespace-pre snippet-pre" tabindex="0"><code id="code-output-html"></code></pre>
      </div>

      <!-- Container Query Panel -->
      <div id="panel-code-cq" role="tabpanel" aria-labelledby="tab-code-cq" hidden>
        <pre class="whitespace-pre snippet-pre" tabindex="0"><code id="code-output-cq"></code></pre>
      </div>
    </div>

    <div class="mt-md pt-sm border-t small-text text-muted">
      Tip: DFH buttons use zero-specificity <code>:where()</code>. You can customize them via container variables or modifier classes without cascade lock-in.
    </div>
  </div>
</div>

</div>

<style>
  .component-playground {
    overflow: hidden;
    background-color: var(--surface-card, Canvas);
  }

  .playground-stage {
    min-block-size: 14rem;
    padding: var(--spacing-32, 2rem);
    display: flex;
    flex-grow: 1;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--spacing-16, 1rem);
    transition: background-color var(--duration-sm, 150ms) ease;
    position: relative;
  }

  .stage--default {
    background-color: var(--surface, Canvas);
    color-scheme: light;
  }

  .stage--subtle {
    background-color: var(--surface-subtle, #f8fafc);
    color-scheme: light;
  }

  .stage--card {
    background-color: var(--surface-card, #ffffff);
    box-shadow: inset 0 0 0 1px var(--border-color-quiet, currentColor);
    color-scheme: light;
  }

  .stage--dark {
    background-color: var(--surface-dark, #0f172a);
    color: var(--foreground-on-dark, #ffffff);
    color-scheme: dark;
  }

  .stage-target-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    min-block-size: 4rem;
  }

  .stage-feedback {
    font-size: var(--typography-font-size--1, 0.875rem);
    text-align: center;
  }

  :is(.border-top, .bt) {
    border-block-start: 1px solid var(--border-color-quiet, currentColor);
  }

  :is(.border-inline-end, .br) {
    border-inline-end: 1px solid var(--border-color-quiet, currentColor);
  }

  .snippet-pre {
    margin: 0;
    padding: var(--spacing-12, 0.75rem);
    background-color: var(--surface-subtle, #f1f5f9);
    border-radius: var(--radius, 0.25rem);
    font-family: var(--typography-code-font-family, 'JetBrains Mono', monospace);
    font-size: 0.82rem;
    line-height: 1.5;
    color: var(--foreground, currentColor);
    overflow-x: auto;
    min-block-size: 10rem;
    max-block-size: 14rem;
  }

  .snippet-pre code {
    background: transparent;
    padding: 0;
    border: none;
    font-family: inherit;
  }

  /* Swatches */
  .swatch {
    display: inline-block;
    inline-size: 1rem;
    block-size: 1rem;
    border-radius: var(--radius-sm, 0.25rem);
    border: 1px solid var(--border-color-muted, currentColor);
  }

  .swatch--canvas { background-color: var(--surface, Canvas); color-scheme: light; }
  .swatch--subtle { background-color: var(--surface-subtle, #f1f5f9); color-scheme: light; }
  .swatch--card { background-color: var(--surface-card, #ffffff); color-scheme: light; }
  .swatch--dark { background-color: var(--surface-dark, #0f172a); color-scheme: dark; }

  .surface-btn.is-active {
    --color-palette: initial;
    box-shadow: 0 0 0 2px var(--foreground-accent, #008076);
    border-radius: var(--radius-sm, 0.25rem);
  }

  .check-icon {
    color: var(--foreground-success, #008060);
  }
</style>

<script is:inline>
  (() => {
    const stage = document.getElementById('playground-stage');
    const stageBtn = document.getElementById('stage-button');
    const feedback = document.getElementById('playground-feedback');

    // Controls
    const ctrlProminence = document.getElementById('ctrl-prominence');
    const ctrlTone = document.getElementById('ctrl-tone');
    const ctrlSize = document.getElementById('ctrl-size');
    const ctrlCorners = document.getElementById('ctrl-corners');
    const ctrlIcon = document.getElementById('ctrl-icon');
    const ctrlLabel = document.getElementById('ctrl-label');
    const ctrlStateActive = document.getElementById('ctrl-state-active');
    const ctrlStateDisabled = document.getElementById('ctrl-state-disabled');

    const codeHtml = document.getElementById('code-output-html');
    const codeCq = document.getElementById('code-output-cq');
    const copyBtn = document.getElementById('playground-copy-btn');

    let clickCount = 0;

    if (stageBtn) {
      stageBtn.addEventListener('click', () => {
        clickCount++;
        if (feedback) {
          feedback.innerHTML = `<strong>Action fired!</strong> Clicked ${clickCount} time${clickCount === 1 ? '' : 's'}. Target size meets WCAG 2.2 touch target requirements.`;
        }
      });
    }

    // Surface Switcher
    const surfaceBtns = document.querySelectorAll('.surface-btn');
    surfaceBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        surfaceBtns.forEach((b) => b.classList.remove('is-active'));
        btn.classList.add('is-active');
        const surface = btn.getAttribute('data-surface');
        stage.className = `playground-stage stage--${surface}`;
      });
    });

    // Tab switcher between HTML and Container Query
    const tabHtml = document.getElementById('tab-code-html');
    const tabCq = document.getElementById('tab-code-cq');
    const panelHtml = document.getElementById('panel-code-html');
    const panelCq = document.getElementById('panel-code-cq');

    if (tabHtml && tabCq) {
      tabHtml.addEventListener('click', () => {
        tabHtml.classList.add('is-active');
        tabHtml.setAttribute('aria-selected', 'true');
        tabCq.classList.remove('is-active');
        tabCq.setAttribute('aria-selected', 'false');
        panelHtml.hidden = false;
        panelCq.hidden = true;
      });

      tabCq.addEventListener('click', () => {
        tabCq.classList.add('is-active');
        tabCq.setAttribute('aria-selected', 'true');
        tabHtml.classList.remove('is-active');
        tabHtml.setAttribute('aria-selected', 'false');
        panelHtml.hidden = true;
        panelCq.hidden = false;
      });
    }

    function updatePlayground() {
      if (!stageBtn) return;

      const prominence = ctrlProminence.value;
      const tone = ctrlTone.value;
      const size = ctrlSize.value;
      const corners = ctrlCorners.value;
      const icon = ctrlIcon.value;
      const labelText = ctrlLabel.value.trim() || 'Action';
      const isActive = ctrlStateActive.checked;
      const isDisabled = ctrlStateDisabled.checked;

      // Construct class list
      const classes = ['button'];

      if (prominence === 'strong') classes.push('button--strong');
      if (prominence === 'subtle') classes.push('button--subtle');
      if (prominence === 'plain') classes.push('button--plain');
      if (prominence === 'placeholder') classes.push('button--placeholder');

      if (tone === 'accent') classes.push('button--accent');
      if (tone === 'danger') classes.push('button--danger');

      if (size === 'sm') classes.push('button--sm');
      if (size === 'lg') classes.push('button--lg');

      if (corners === 'pill') classes.push('button--pill');
      if (corners === 'round') classes.push('button--round');

      if (icon === 'icon-only') classes.push('button--icon');
      if (isActive) classes.push('is-active');

      stageBtn.className = classes.join(' ');

      // Disabled attributes
      if (isDisabled) {
        stageBtn.disabled = true;
        stageBtn.setAttribute('aria-disabled', 'true');
      } else {
        stageBtn.disabled = false;
        stageBtn.removeAttribute('aria-disabled');
      }

      // Inner content
      let innerHtml = '';
      let codeMarkup = '';

      if (icon === 'none') {
        innerHtml = `<span>${labelText}</span>`;
        codeMarkup = `<button type="button" class="${classes.join(' ')}"${isDisabled ? ' disabled aria-disabled="true"' : ''}>\n  <span>${labelText}</span>\n</button>`;
      } else if (icon === 'leading') {
        innerHtml = `<svg class="icon" width="1em" height="1em" aria-hidden="true" focusable="false"><use href="/icons.svg#Plus"/></svg>\n<span>${labelText}</span>`;
        codeMarkup = `<button type="button" class="${classes.join(' ')}"${isDisabled ? ' disabled aria-disabled="true"' : ''}>\n  <svg class="icon" width="1em" height="1em" aria-hidden="true" focusable="false">\n    <use href="#Plus"/>\n  </svg>\n  <span>${labelText}</span>\n</button>`;
      } else if (icon === 'trailing') {
        innerHtml = `<span>${labelText}</span>\n<svg class="icon icon--dir" width="1em" height="1em" aria-hidden="true" focusable="false"><use href="/icons.svg#ArrowRight"/></svg>`;
        codeMarkup = `<button type="button" class="${classes.join(' ')}"${isDisabled ? ' disabled aria-disabled="true"' : ''}>\n  <span>${labelText}</span>\n  <svg class="icon icon--dir" width="1em" height="1em" aria-hidden="true" focusable="false">\n    <use href="#ArrowRight"/>\n  </svg>\n</button>`;
      } else if (icon === 'icon-only') {
        innerHtml = `<span class="sr-only">${labelText}</span>\n<svg class="icon" width="1em" height="1em" aria-hidden="true" focusable="false"><use href="/icons.svg#Search"/></svg>`;
        codeMarkup = `<!-- Accessible Icon Button: .visually-hidden enables browser translation & voice control -->\n<button type="button" class="${classes.join(' ')}"${isDisabled ? ' disabled aria-disabled="true"' : ''}>\n  <span class="sr-only">${labelText}</span>\n  <svg class="icon" width="1em" height="1em" aria-hidden="true" focusable="false">\n    <use href="#Search"/>\n  </svg>\n</button>`;
      }

      stageBtn.innerHTML = innerHtml;
      if (codeHtml) codeHtml.textContent = codeMarkup;

      // Container Query alternative
      const cqProperties = [];
      if (prominence !== 'default') cqProperties.push(`  --button-prominence: ${prominence};`);
      if (tone !== 'neutral') cqProperties.push(`  --button-intent: ${tone};`);
      if (size === 'sm') cqProperties.push(`  --ui-sizing: compact;`);
      if (size === 'lg') cqProperties.push(`  --button-size: lg;`);
      if (corners !== 'default') cqProperties.push(`  --button-corners: ${corners};`);

      const cqText = `/* Declarative Context Orchestration */\n.my-container {\n${cqProperties.length ? cqProperties.join('\n') : '  /* Default configuration */'}\n}\n\n/* Nested child buttons adapt automatically: */\n.my-container .button {\n  /* No manual class juggling required! */\n}`;
      if (codeCq) codeCq.textContent = cqText;
    }

    // Attach listeners
    [ctrlProminence, ctrlTone, ctrlSize, ctrlCorners, ctrlIcon, ctrlLabel, ctrlStateActive, ctrlStateDisabled].forEach((el) => {
      if (el) {
        el.addEventListener('input', updatePlayground);
        el.addEventListener('change', updatePlayground);
      }
    });

    // Copy Button
    if (copyBtn) {
      copyBtn.addEventListener('click', async () => {
        const activeTab = tabHtml.classList.contains('is-active') ? 'html' : 'cq';
        const textToCopy = activeTab === 'html' ? codeHtml.textContent : codeCq.textContent;

        try {
          await navigator.clipboard.writeText(textToCopy);
          const copyIcon = copyBtn.querySelector('.copy-icon');
          const checkIcon = copyBtn.querySelector('.check-icon');
          const label = copyBtn.querySelector('.copy-label');

          if (copyIcon && checkIcon) {
            copyIcon.classList.add('hide');
            checkIcon.classList.remove('hide');
          }
          if (label) label.textContent = 'Copied!';

          setTimeout(() => {
            if (copyIcon && checkIcon) {
              copyIcon.classList.remove('hide');
              checkIcon.classList.add('hide');
            }
            if (label) label.textContent = 'Copy';
          }, 2000);
        } catch (e) {
          console.error(e);
        }
      });
    }

    // Initial render
    updatePlayground();
  })();
</script>
