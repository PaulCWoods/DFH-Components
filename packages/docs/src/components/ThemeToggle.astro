---
import Icon from './Icon.astro';
---

<button
  type="button"
  id="theme-toggle"
  class="button button--subtle button--icon"
  title="Theme: Auto (system)"
>
  <Icon class="theme-icon theme-icon-light" name="Light" size={20} />
  <Icon class="theme-icon theme-icon-dark" name="Moon" size={20} />
  <Icon class="theme-icon theme-icon-auto" name="LightDark" size={20} />
  <span id="theme-toggle-text" class="button__text" aria-live="polite">
    Theme: Auto (system)
  </span>
</button>

<style is:global>
  #theme-toggle {
    position: relative;
    overflow: hidden;
  }

  /* Hide all theme icons by default — guarantees multiple icons never show simultaneously */
  #theme-toggle .theme-icon {
    display: none !important;
    align-items: center;
    justify-content: center;
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.15s ease;
  }

  /* ------------------------------------------------------------------------
     1. Resting States (Current active theme icon visible when not hovered)
     ------------------------------------------------------------------------ */
  html:not([data-theme]) #theme-toggle:not(:hover) .theme-icon-auto,
  html[data-theme='auto'] #theme-toggle:not(:hover) .theme-icon-auto,
  html[data-theme='system'] #theme-toggle:not(:hover) .theme-icon-auto {
    display: inline-flex !important;
  }

  html[data-theme='dark'] #theme-toggle:not(:hover) .theme-icon-dark {
    display: inline-flex !important;
  }

  html[data-theme='light'] #theme-toggle:not(:hover) .theme-icon-light {
    display: inline-flex !important;
  }

  /* ------------------------------------------------------------------------
     2. Hover States: Preview the next theme in the toggle sequence
        Sequence: Auto (system) -> Dark -> Light -> Auto
     ------------------------------------------------------------------------ */
  @media (hover: hover) {
    /* When Auto: hover previews Dark (Moon) */
    html:not([data-theme]) #theme-toggle:hover .theme-icon-dark,
    html[data-theme='auto'] #theme-toggle:hover .theme-icon-dark,
    html[data-theme='system'] #theme-toggle:hover .theme-icon-dark {
      display: inline-flex !important;
      transform: rotate(-12deg) scale(1.08);
    }

    /* When Dark: hover previews Light (Sun) */
    html[data-theme='dark'] #theme-toggle:hover .theme-icon-light {
      display: inline-flex !important;
      transform: rotate(20deg) scale(1.08);
    }

    /* When Light: hover previews Auto (LightDark) */
    html[data-theme='light'] #theme-toggle:hover .theme-icon-auto {
      display: inline-flex !important;
      transform: rotate(10deg) scale(1.08);
    }
  }

  /* Touch devices fallback (no hover): keep active icon visible on tap/press */
  @media (hover: none) {
    html:not([data-theme]) #theme-toggle .theme-icon-auto,
    html[data-theme='auto'] #theme-toggle .theme-icon-auto,
    html[data-theme='system'] #theme-toggle .theme-icon-auto,
    html[data-theme='dark'] #theme-toggle .theme-icon-dark,
    html[data-theme='light'] #theme-toggle .theme-icon-light {
      display: inline-flex !important;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #theme-toggle .theme-icon {
      transition: none;
      transform: none !important;
    }
  }
</style>

<script is:inline>
  (() => {
    const getPreferredTheme = () => {
      const stored = localStorage.getItem('dfh-theme');
      if (stored === 'light' || stored === 'dark') return stored;
      return null; // system auto
    };

    const updateLabel = (theme) => {
      const textEl = document.getElementById('theme-toggle-text');
      const toggleBtn = document.getElementById('theme-toggle');
      let label = 'Theme: Auto (system)';
      let title = 'Theme: Auto (system). Click to switch to dark theme.';
      if (theme === 'dark') {
        label = 'Theme: Dark';
        title = 'Theme: Dark. Click to switch to light theme.';
      } else if (theme === 'light') {
        label = 'Theme: Light';
        title = 'Theme: Light. Click to switch to auto theme.';
      }
      if (textEl) textEl.textContent = label;
      if (toggleBtn) toggleBtn.setAttribute('title', title);
    };

    const applyTheme = (theme) => {
      const root = document.documentElement;
      if (theme === 'dark' || theme === 'light') {
        root.setAttribute('data-theme', theme);
        root.style.colorScheme = theme;
      } else {
        root.removeAttribute('data-theme');
        root.style.colorScheme = 'light dark';
      }
      updateLabel(theme);
    };

    // Apply immediately on load
    applyTheme(getPreferredTheme());

    document.addEventListener('DOMContentLoaded', () => {
      updateLabel(getPreferredTheme());
      const toggleBtn = document.getElementById('theme-toggle');
      if (!toggleBtn) return;

      toggleBtn.addEventListener('click', () => {
        const current = document.documentElement.getAttribute('data-theme');
        let next = null;
        if (current === 'dark') {
          next = 'light';
        } else if (current === 'light') {
          next = null;
        } else {
          next = 'dark';
        }

        if (next) {
          localStorage.setItem('dfh-theme', next);
        } else {
          localStorage.removeItem('dfh-theme');
        }
        applyTheme(next);
      });
    });
  })();
</script>
