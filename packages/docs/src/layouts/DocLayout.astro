---
/* ==========================================================================
   A docs page: the section's pages in a sidebar (from 48rem; the drawer
   below), the article, and "On this page" in an end sidebar from the xl
   width when the page has two or more sections. Pagefind indexes the
   article only.
   ========================================================================== */
import BaseLayout from './BaseLayout.astro';
import NavTree from '../components/NavTree.astro';
import PageNav from '../components/PageNav.astro';
import { flatten, type Section } from '../lib/nav';

interface Props {
  title: string;
  summary: string;
  nav: Section[];
  current: string;
  headings: { depth: number; slug: string; text: string }[];
  /* A word above the title: a component's tier */
  eyebrow?: string;
}
const { title, summary, nav, current, headings, eyebrow } = Astro.props;
const pages = flatten(nav);
const at = pages.findIndex((p) => p.href === current);
const toc = headings.filter((h) => h.depth === 2);
---
<BaseLayout title={title} description={summary} nav={nav} current={current}>
  <div class="app__workspace">
    <div class="sidebar sidebar--sticky max-lg:hide">
      <div class="sidebar__body">
        <NavTree nav={nav} current={current} mode="section" idPrefix="section-nav" />
      </div>
    </div>
    <main id="main" class="main">
      <div class="wrapper stack gap-cushion">
        <article class="prose" data-pagefind-body>
          {eyebrow ? (
            <hgroup>
              <p class="micro-heading text-muted">{eyebrow}</p>
              <h1>{title}</h1>
            </hgroup>
          ) : <h1>{title}</h1>}
          <p class="large-text text-muted">{summary}</p>
          <hr />
          <slot />
        </article>
        <PageNav prev={pages[at - 1]} next={pages[at + 1]} />
      </div>
    </main>
    {toc.length > 1 && (
      <div class="sidebar sidebar--end sidebar--plain sidebar--sticky max-xl:hide">
        <div class="sidebar__body">
          <nav class="navigation-tree navigation-tree--ruled navigation-tree--compact" aria-labelledby="toc-heading">
            <ol>
              <li class="navigation-tree__heading"><h2 id="toc-heading" class="subheading">On this page</h2></li>
              {toc.map((h) => <li><a href={`#${h.slug}`} class="button"><span>{h.text}</span></a></li>)}
            </ol>
          </nav>
        </div>
      </div>
    )}
  </div>
</BaseLayout>

<script>
  import { compose, toLive } from '../lib/playground.mjs';

  /* Examples of a component whose behaviour is the product's run a demo script */
  const demo = (root: ParentNode) => {
    if (root.querySelector('.combobox')) {
      import('../lib/combobox-demo').then(({ enhance }) => enhance(root as HTMLElement));
    }
    if (root.querySelector('[role="tablist"]')) {
      import('../lib/tabs-demo').then(({ enhance }) => enhance(root));
    }
  };
  demo(document);

  /* Playgrounds: a choice rebuilds the example and its code */
  for (const figure of document.querySelectorAll<HTMLElement>('[data-playground]')) {
    const controls = figure.querySelector<HTMLElement>('[data-controls]')!;
    controls.hidden = false;
    controls.addEventListener('change', () => {
      const chosen = [...controls.querySelectorAll<HTMLInputElement>('input:checked')];
      const classes = chosen.flatMap((c) => c.dataset.classes!.split(' ').filter(Boolean));
      const text = chosen.findLast((c) => c.dataset.text)?.dataset.text;
      const code = compose(figure.dataset.source!, classes, text);
      const preview = figure.querySelector<HTMLElement>('[data-preview]')!;
      preview.innerHTML = toLive(code);
      demo(preview);
      figure.querySelector('.code-block code')!.textContent = code;
    });
  }

  /* Copy buttons appear only where the clipboard works */
  if (navigator.clipboard) {
    for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
      button.hidden = false;
      button.addEventListener('click', async () => {
        const block = button.closest('.code-block')!;
        await navigator.clipboard.writeText(block.querySelector('code')!.textContent!);
        block.querySelector('[data-copy-status]')!.textContent = 'Copied';
      });
    }
  }
</script>


<style is:global>
  /* The Code row sits in a ruled card, which draws its rule and corners */
  [data-example], [data-playground] {
    overflow: clip;

    .accordion--flush {
      --rule-width: 0px;
    }
  }

  /* A Skip Link hides until it has focus: an example shows it open, flat */
  [data-example] {
    .skip-link {
      block-size: auto;
      min-block-size: var(--skip-link-min-size, 3rem);
    }

    .skip-link--floating {
      inline-size: fit-content;
      opacity: 1;
      pointer-events: auto;
      position: static;
      translate: none;
    }
  }

  @scope (:where(article.prose)) to (:where(.prose-end)) {
    table {
      inline-size: 100%;
    }

    .table-container {
      margin-block: var(--_prose-space);
    }
  }
</style>