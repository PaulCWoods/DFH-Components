---
/* ==========================================================================
   A docs page: the section's pages in a sidebar (from 48rem; the drawer
   below), the article, and "On this page" in an end sidebar from the xl
   width when the page has two or more sections. Pagefind indexes the
   article only.
   ========================================================================== */
import BaseLayout from './BaseLayout.astro';
import NavTree from '../components/NavTree.astro';
import PageNav from '../components/PageNav.astro';
import { flatten, type Section } from '../lib/nav';
import '@design-for-humans/components-css/themes/docs.css';

interface Props {
  title: string;
  summary: string;
  nav: Section[];
  current: string;
  headings: { depth: number; slug: string; text: string }[];
  /* A word above the title: a component's tier */
  eyebrow?: string;
}
const { title, summary, nav, current, headings, eyebrow } = Astro.props;
const pages = flatten(nav);
const at = pages.findIndex((p) => p.href === current);
const toc = headings.filter((h) => h.depth === 2);
---
<BaseLayout title={title} description={summary} nav={nav} current={current}>
  <div class="app__workspace theme-docs">
    <div class="sidebar sidebar--sticky max-lg:hide fine:ui-compact">
      <div class="sidebar__body">
        <NavTree nav={nav} current={current} mode="section" idPrefix="section-nav" />
      </div>
    </div>
    <main id="main" class="main">
      <div class="wrapper stack gap-cushion">
        <article class="prose" data-pagefind-body>
          {eyebrow ? (
            <hgroup>
              <p class="micro-heading text-muted">{eyebrow}</p>
              <h1>{title}</h1>
            </hgroup>
          ) : <h1>{title}</h1>}
          <p class="large-text text-muted text-pretty">{summary}</p>
          <hr />
          <slot />
        </article>
        <PageNav prev={pages[at - 1]} next={pages[at + 1]} />
      </div>
    </main>
    {toc.length > 1 && (
      <div class="sidebar sidebar--end sidebar--plain sidebar--sticky max-xl:hide fine:ui-compact">
        <div class="sidebar__body">
          <nav class="navigation-tree navigation-tree--ruled" aria-labelledby="toc-heading">
            <ol>
              <li class="navigation-tree__heading"><h2 id="toc-heading" class="subheading">On this page</h2></li>
              {toc.map((h) => <li><a href={`#${h.slug}`} class="button"><span>{h.text}</span></a></li>)}
            </ol>
          </nav>
        </div>
      </div>
    )}
  </div>
</BaseLayout>

<script>
  import { compose, toLive } from '../lib/playground.mjs';

  /* Examples work. Where a behaviour is the product's script, the page runs
     a demo script (lib/demos) on the example and says so under it; the
     code shows the markup only. A demo figure names its script. */
  const scripts = import.meta.glob<{ enhance: (root: HTMLElement) => void }>('../lib/demos/*.ts');
  const SOURCE = 'https://github.com/PaulCWoods/DFH-Components/blob/main/packages/docs/src/lib/demos';
  const WORKS: Record<string, string> = {
    range: 'input.range',
    toggle: 'button[aria-pressed]:not(.input-frame *, .range-lockup *)',
    password: '.input-frame button[aria-controls][aria-pressed]',
    sort: '.table__sort-button',
    copy: '.code-block__bar button',
    combobox: '.combobox',
    tabs: '[role="tablist"]',
  };
  const run = (name: string, root: HTMLElement) => scripts[`../lib/demos/${name}.ts`]?.().then(({ enhance }) => enhance(root));
  const enhance = (root: HTMLElement) => {
    const names = Object.keys(WORKS).filter((name) => root.querySelector(WORKS[name]));
    names.forEach((name) => run(name, root));
    return names;
  };
  for (const live of document.querySelectorAll<HTMLElement>('[data-live]')) {
    const demo = live.closest<HTMLElement>('[data-demo]');
    if (demo) { run(demo.dataset.demo!, live); continue; }
    const names = enhance(live);
    if (!names.length) continue;
    const note = document.createElement('p');
    note.className = 'small-text text-muted mt-md';
    note.innerHTML = `Works here with a short script of the product's own; the code shows the markup only. ${names.map((n) => `<a href="${SOURCE}/${n}.ts">Read the ${n} script</a>`).join(', ')}`;
    live.append(note);
  }

  /* Playgrounds: a choice rebuilds the example and its code */
  for (const figure of document.querySelectorAll<HTMLElement>('[data-playground]')) {
    const controls = figure.querySelector<HTMLElement>('[data-controls]')!;
    controls.hidden = false;
    controls.addEventListener('change', () => {
      const chosen = [...controls.querySelectorAll<HTMLInputElement>('input:checked')];
      const classes = chosen.flatMap((c) => c.dataset.classes!.split(' ').filter(Boolean));
      const text = chosen.findLast((c) => c.dataset.text)?.dataset.text;
      const code = compose(figure.dataset.source!, classes, text);
      const preview = figure.querySelector<HTMLElement>('[data-preview]')!;
      preview.innerHTML = toLive(code);
      enhance(preview);
      figure.querySelector('.code-block code')!.textContent = code;
    });
  }

  /* Copy buttons appear only where the clipboard works */
  if (navigator.clipboard) {
    for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
      button.hidden = false;
      button.addEventListener('click', async () => {
        const block = button.closest('.code-block')!;
        await navigator.clipboard.writeText(block.querySelector('code')!.textContent!);
        block.querySelector('[data-copy-status]')!.textContent = 'Copied';
      });
    }
  }
</script>


<style is:global>
  /* The Code row sits in a ruled card, which draws its rule and corners */
  [data-example], [data-playground] {
    overflow: clip;
  }

  /* A Skip Link hides until it has focus: an example shows it open, flat */
  [data-example] {
    .skip-link {
      block-size: auto;
      min-block-size: var(--skip-link-min-size, 3rem);
    }

    .skip-link--floating {
      inline-size: fit-content;
      opacity: 1;
      pointer-events: auto;
      position: static;
      translate: none;
    }
  }

  @scope (:where(article.prose)) to (:where(.prose-end)) {
    table {
      inline-size: 100%;
    }

    .table-container {
      margin-block: var(--_prose-space);
    }

    /* Equal columns, wide enough to read: a narrower screen scrolls the table */
    .do-dont {
      table-layout: fixed;
    }

    .do-dont__point {
      align-items: start;
      display: flex;
      gap: var(--spacing-xs);

      > .icon {
        block-size: 1lh;
        flex: none;
      }

      > div {
        min-inline-size: 0;
        overflow-wrap: anywhere;
      }
    }
  }
</style>