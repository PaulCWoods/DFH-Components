---
/* ==========================================================================
   The page: head, fonts, colour scheme, and the library's app shell
   (§19d): skip link, sticky header, the page's own content, footer, and
   the search dialog. No docs CSS: everything here is the library.
   The font links between the theme-fonts markers in the head are written
   by build:type and the designer's Publish. Don't quote the markers
   anywhere else in this file: the writer replaces from the first one.
   ========================================================================== */
import '@design-for-humans/components-css/src/index.css';
import '@design-for-humans/components-css/src/fonts.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Search from '../components/Search.astro';
import type { Section } from '../lib/nav';

interface Props { title: string; description: string; nav: Section[]; current: string }
const { title, description, nav, current } = Astro.props;
const fullTitle = title === 'Design For Humans Components' ? title : `${title} · Design For Humans Components`;
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <!-- theme fonts -->
    <link rel="stylesheet" href="https://use.typekit.net/lrj6kun.css" />
    <!-- /theme fonts -->
    <script is:inline>
      /* The remembered colour scheme, before the first paint (SchemeToggle) */
      try {
        const s = localStorage.getItem('dfh-scheme');
        if (s === 'light' || s === 'dark') document.documentElement.classList.add('color-scheme-' + s);
      } catch {}
    </script>
  </head>
  <body class="app">
    <a href="#main" class="skip-link">Skip to content</a>
    <Header nav={nav} current={current} />
    <slot />
    <Footer />
    <Search />
  </body>
</html>
