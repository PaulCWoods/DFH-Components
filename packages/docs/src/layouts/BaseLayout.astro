---
/* ==========================================================================
   The page: head, fonts, colour scheme, and the library's app shell
   (§19d): skip link, sticky header, the page's own content, footer, and
   the search dialog. The home page has no header, so no search dialog
   either, as nothing could open it. No docs CSS: everything here is the library.
   The site wears the DFH theme (the site theme in tokens/themes.json),
   linked after the library. The font links between the theme-fonts markers
   in the head are written by build:themes and the designer's Publish. Don't quote the markers
   anywhere else in this file: the writer replaces from the first one.
   ========================================================================== */
import '@design-for-humans/components-css/index.css';
import '@design-for-humans/components-css/themes/dfh.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Search from '../components/Search.astro';
import type { Section } from '../lib/nav';

interface Props { title: string; description: string; nav: Section[]; current: string; header?: boolean }
const { title, description, nav, current, header = true } = Astro.props;
/* Out of search engines until the public launch sets PUBLIC_INDEXABLE=true */
const indexable = import.meta.env.PUBLIC_INDEXABLE === 'true';
const fullTitle = title === 'Design For Humans Components' ? title : `${title} · Design For Humans Components`;
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {!indexable && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="icon" type="image/svg+xml" href="/favicons/favicon.svg" />
    <link rel="icon" href="/favicons/favicon.ico" sizes="32x32 48x48" />
    <link rel="apple-touch-icon" href="/favicons/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <!-- theme fonts -->
    <link rel="stylesheet" href="https://use.typekit.net/lrj6kun.css" />
    <!-- /theme fonts -->
    <script is:inline>
      /* The remembered colour scheme, before the first paint (SchemeToggle) */
      try {
        const s = localStorage.getItem('dfh-scheme');
        if (s === 'light' || s === 'dark') document.documentElement.classList.add('color-scheme-' + s);
      } catch {}
    </script>
  </head>
  <body class="app">
    <a href="#main" class="skip-link">Skip to content</a>
    {header && <Header nav={nav} current={current} />}
    <slot />
    <Footer />
    {header && <Search />}
  </body>
</html>
