---
import DocLayout from '../../layouts/DocLayout.astro';
import Icon from '../../components/Icon.astro';

const categories = [
  {
    title: 'Atoms',
    description: 'Foundational, indivisible primitives adhering to zero-specificity :where() and fluid typography.',
    items: [
      { name: 'Button', href: '/components/atoms/button', badge: 'Prototype Active', badgeClass: 'badge--accent badge--strong', desc: 'Bedrock interactive control with 48px WCAG AAA target sizing and container queries.' },
      { name: 'Tab Primitive', href: '/components/atoms/tab', badge: 'Updated', badgeClass: 'badge--subtle', desc: 'Single-source interactive tab trigger for tab lists and navigation bars.' },
      { name: 'Badge & Chip', href: '/components/atoms/badge', desc: 'Status counters, semantic pills, and removable filter tags.' },
      { name: 'Input & Textarea', href: '/components/atoms/input', desc: 'Accessible text inputs with floating labels and error states.' },
      { name: 'Switch & Checkbox', href: '/components/atoms/switch', desc: 'Accessible zero-JS toggle switches and radio choice controls.' },
      { name: 'Typography Atoms', href: '/components/atoms/text', desc: 'Semantic headings, subheadings, micro-text, and body typography.' },
    ],
  },
  {
    title: 'Molecules',
    description: 'Composed combinations of 2–3 atoms orchestrating local state and compound layout.',
    items: [
      { name: 'Tab List', href: '/components/molecules/tab-list', badge: 'New', badgeClass: 'badge--accent', desc: 'Semantic tabs navigation with horizontal and vertical orientations.' },
      { name: 'Button Group', href: '/components/molecules/button-group', desc: 'Clustered, segmented, and stacked action groups with auto-rule separators.' },
      { name: 'Field & Fieldset', href: '/components/molecules/field', desc: 'Label, input, helper text, and validation message lockup.' },
      { name: 'Banner & Alert', href: '/components/molecules/banner', desc: 'Prominent contextual system notifications with status icons.' },
      { name: 'Popover & Tooltip', href: '/components/molecules/popover', desc: 'Native popover attribute with CSS Anchor Positioning.' },
    ],
  },
  {
    title: 'Organisms',
    description: 'Complex composite assemblies that orchestrate layout geometry without clobbering nested atoms.',
    items: [
      { name: 'Card & Deck', href: '/components/organisms/card', desc: 'Multi-region content containers with ruled headers, bodies, and footers.' },
      { name: 'Dialog', href: '/components/organisms/dialog', badge: 'HTML5', badgeClass: 'badge--subtle', desc: 'Native HTML5 dialog with declarative Invoker Commands.' },
      { name: 'Menu & Context Menu', href: '/components/organisms/menu', desc: 'Keyboard-navigable action menus and dropdown option lists.' },
      { name: 'Table', href: '/components/organisms/table', desc: 'Dense data grids with sticky headers, numeric alignments, and sortable columns.' },
    ],
  },
];
---

<DocLayout title="Components Catalog" currentSection="components" currentPath="/components">
  <div class="margin-bottom-xl">
    <div class="inline align-items-center gap-sm margin-bottom-xs">
      <h1 class="display-title margin-0">Component Library</h1>
      <span class="badge badge--accent badge--sm"><span>WCAG 2.2 Ready</span></span>
    </div>
    <p class="lede text-muted">
      Explore the modular, token-driven component architecture of Design For Humans. Built on Web Standards, native HTML primitives, zero-specificity cascade rules, and container style queries.
    </p>

    <!-- Featured Component Spotlight Banner -->
    <div class="card card--bordered card--translucent margin-block-lg">
      <div class="card__content padding-md">
        <div class="split split--end align-items-center gap-md">
          <div class="stack gap-xs">
            <div class="inline align-items-center gap-xs">
              <span class="badge badge--accent badge--strong badge--sm"><span>Featured Prototype</span></span>
              <span class="micro-heading text-muted">Atom Primitive</span>
            </div>
            <h2 class="heading margin-0">Button Component Prototype</h2>
            <p class="small-text text-muted margin-0">
              Interactive playground, anatomy variations, target-size ergonomics (48px AAA), WCAG 2.2 compliance matrix, design tokens, and Do’s & Don’ts.
            </p>
          </div>
          <div class="flex justify-end">
            <a href="/components/atoms/button" class="button button--strong button--accent" role="button">
              <span>View Button Documentation</span>
              <Icon name="ArrowRight" size={14} class="icon--dir" />
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Component Categories -->
  <div class="stack gap-xl">
    {categories.map((cat) => (
      <section class="component-category">
        <div class="margin-bottom-sm">
          <h2 class="heading margin-0">{cat.title}</h2>
          <p class="small-text text-muted margin-0">{cat.description}</p>
        </div>

        <div class="grid md:grid--2-col lg:grid--3-col gap-md">
          {cat.items.map((item) => (
            <a href={item.href} class="card card--bordered card--interactive link link--plain p-md block">
              <div class="stack gap-xs">
                <div class="inline inline--between align-items-center">
                  <span class="font-weight-bold text-accent">{item.name}</span>
                  {item.badge && (
                    <span class:list={['badge', 'badge--sm', item.badgeClass || 'badge--subtle']}>
                      <span>{item.badge}</span>
                    </span>
                  )}
                </div>
                <p class="small-text text-muted margin-0">{item.desc}</p>
              </div>
            </a>
          ))}
        </div>
      </section>
    ))}
  </div>
</DocLayout>

<style>
  .p-md {
    padding: var(--spacing-16, 1rem);
  }

  .card--interactive {
    transition: transform var(--duration-sm, 150ms) ease, border-color var(--duration-sm, 150ms) ease;
  }

  .card--interactive:hover {
    border-color: var(--foreground-accent, #008076);
    transform: translateY(-2px);
  }
</style>
