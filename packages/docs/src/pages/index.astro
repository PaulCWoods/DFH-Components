---
/* The home page. It becomes the brochure (docs-site plan, phase 6); until
   then, a short introduction and the way into the docs. */
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { getNav } from '../lib/nav';

const nav = await getNav();
const sections = nav.filter((s) => s.key);
---
<BaseLayout title="Design For Humans Components" description="An accessible, token-driven component library built on web standards." nav={nav} current="/">
  <main id="main" class="main">
    <div class="wrapper stack gap-cushion">
      <div class="stack gap-sm max-inline-size-2xl">
        <h1 class="display-title">Components for humans</h1>
        <p class="large-text text-muted">An accessible, token-driven component library on native HTML and modern CSS, for designers and developers working from one source.</p>
        <div class="cluster">
          <a href="/docs/" class="button button--strong button--accent"><span>Read the docs</span><Icon name="ArrowRight" class="icon--dir" /></a>
        </div>
      </div>
      {sections.length > 0 && (
        <ul class="grid grid--3-col gap-sm" role="list" aria-label="Sections">
          {sections.map((s) => (
            <li>
              <a href={s.href} class="block-link">
                <span class="block-link__text"><span class="small-heading">{s.label}</span><br /><span class="small-text text-muted">{s.pages[0].summary}</span></span>
                <Icon name="ArrowRight" class="block-link__arrow icon--dir" />
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </main>
</BaseLayout>
