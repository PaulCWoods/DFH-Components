---
/* The home page. It becomes the brochure (docs-site plan, phase 6); until
   then, a short introduction and the way into the docs. */
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { getNav } from '../lib/nav';

const nav = await getNav();
const sections = nav.filter((s) => s.key);
---
<BaseLayout title="Design For Humans Components" description="An accessible, token-driven component library built on web standards." nav={nav} current="/" header={false}>
  <main id="main" class="main font-sizing-fluid">
    <article class="wrapper stack gap-cushion">
      <header class="brochure-header stack max-inline-size-2xl">
        <h1 class="display-title brand-frame">
          Design for Humans: <span class="home__title-highlight">Cmpnts</span>
        </h1>
        <p class="large-text text-muted">An accessible, token-driven component library on native HTML and modern CSS, for designers and developers working from one source.</p>
        <div class="cluster">
          <a href="/docs/" class="button button--strong button--accent"><span>Read the docs</span><Icon name="ArrowRight" class="icon--dir" /></a>
        </div>
      </header>
      {sections.length > 0 && (
        <ul class="grid grid--sm" role="list" aria-label="Sections">
          {sections.map((s) => (
            <li>
              <article class="card h-full">
                <header class="card__header">
                  <h2 class="card__title heading"><a href={s.href} class="link link--plain link--stretched">{s.label}</a></h2>
                </header>
                <div class="card__body"><p class="text">{s.pages[0].summary}</p></div>
              </article>
            </li>
          ))}
        </ul>
      )}
    </article>
  </main>
</BaseLayout>

<style>
:is(.brand-logo, .brand-frame) {
    border: var(--brand-border-width, 0.125em) solid currentColor;
    padding-block: var(--brand-padding-block, 0.125em);
    padding-inline: var(--brand-padding-inline, 0.095em);
    text-box: trim-both cap alphabetic;
}

.home__title-highlight {
    color: var(--foreground-accent);
}

.brochure-header {
  gap: calc(var(--spacing-breathe) * var(--sizing-ratio));
}
 </style>