---
/* ==========================================================================
   A component page, from its markup doc (docs/markup/NN-*.md): the doc's
   content (with live examples), then what is generated: the way into
   Storybook, which the site ships at /storybook/, and related components.
   ========================================================================== */
import { getCollection, render } from 'astro:content';
import DocLayout from '../../../../layouts/DocLayout.astro';
import { componentOf, getComponents, getNav } from '../../../../lib/nav';

export async function getStaticPaths() {
  const components = (await getCollection('markup')).map(componentOf).filter((c) => c !== undefined);
  return components.map((c) => ({ params: { tier: c.folder, slug: c.slug }, props: { c } }));
}

const { c } = Astro.props;
const { Content, headings } = await render(c.entry);
const nav = await getNav();
const all = await getComponents();
const related = (c.entry.data.related ?? []).map((s) => all.find((o) => o.slug === s)).filter((o) => o !== undefined);
const tokens = c.entry.data.tokens ?? [];
const stories = c.entry.data.storybook ?? [];
const storybook = import.meta.env.PUBLIC_STORYBOOK_URL ?? '/storybook/';
const inStorybook = stories.length > 0 || tokens.length > 0;
const extra = [
  ...(inStorybook ? [{ depth: 2, slug: 'in-storybook', text: 'In Storybook' }] : []),
  ...(related.length ? [{ depth: 2, slug: 'see-also', text: 'See also' }] : []),
];
---
<DocLayout title={c.title} summary={c.summary} nav={nav} current={Astro.url.pathname} headings={[...headings, ...extra]} eyebrow={c.group}>
  <Content />
  {inStorybook && (
    <>
      <h2 id="in-storybook">In Storybook</h2>
      <ul>
        {stories.map((id) => <li><a href={`${storybook}?path=/docs/${id}--docs`}>Every variant and state</a></li>)}
        {tokens.map((key) => <li><a href={`${storybook}?path=/story/tokens-component-tokens--by-component&args=component:${key}`}>{tokens.length > 1 ? `The ${key} tokens` : 'Its tokens'}</a></li>)}
      </ul>
    </>
  )}
  {related.length > 0 && (
    <>
      <h2 id="see-also">See also</h2>
      <ul>
        {related.map((r) => <li><a href={r.href}>{r.title}</a>: {r.summary}</li>)}
      </ul>
    </>
  )}
</DocLayout>
