---
/* Every page in the docs collection */
import { getCollection, render } from 'astro:content';
import DocLayout from '../../layouts/DocLayout.astro';
import { getNav, slugOf } from '../../lib/nav';

export async function getStaticPaths() {
  const entries = await getCollection('docs');
  return entries.map((entry) => ({ params: { slug: slugOf(entry) }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const nav = await getNav();
---
<DocLayout title={entry.data.title} summary={entry.data.summary} nav={nav} current={Astro.url.pathname} headings={headings}>
  <Content />
</DocLayout>
