{
  "name": "design-for-humans-components",
  "version": "1.0.0",
  "private": true,
  "description": "Accessible, token-driven, AI-agent ready component library",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "prepare": "husky || true",
    "build:tokens": "node packages/theme-engine/bin/build-tokens.js",
    "build:palette": "node packages/theme-engine/bin/build-palette.js",
    "build:type": "node packages/theme-engine/bin/build-type.js",
    "build:space": "node packages/theme-engine/bin/build-space.js",
    "build:shape": "node packages/theme-engine/bin/build-shape.js",
    "build:motion": "node packages/theme-engine/bin/build-motion.js",
    "build:themes": "node packages/theme-engine/bin/build-themes.js",
    "build:components": "node packages/theme-engine/bin/build-components.js",
    "test:theme": "npm test --workspace=@design-for-humans/theme-engine",
    "sync:icons": "node scripts/sync-icons.js",
    "check:utilities": "node scripts/check-utilities.js",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:layout": "node scripts/check-layout.mjs",
    "check:print": "node scripts/check-print.mjs",
    "check:targets": "node scripts/check-targets.mjs",
    "check:focus": "node scripts/check-focus.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "storybook": "npm run storybook --workspace=@design-for-humans/storybook",
    "build:storybook": "npm run build-storybook --workspace=@design-for-humans/storybook",
    "docs": "npm run dev --workspace=@design-for-humans/docs",
    "build:docs": "npm run build --workspace=@design-for-humans/docs",
    "build:css": "node scripts/build-css.mjs",
    "build:skills": "node scripts/build-skills.mjs",
    "build:site": "npm run build:docs && npm run build:storybook && rm -rf packages/docs/dist/storybook && cp -R packages/storybook/storybook-static packages/docs/dist/storybook",
    "images": "node scripts/optimise-images.mjs"
  },
  "devDependencies": {
    "@storybook/html-vite": "^8.0.0",
    "lightningcss": "^1.33.0",
    "prettier": "^3.0.0",
    "sharp": "^0.35.5"
  }
}
