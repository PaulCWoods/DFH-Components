{
  "$description": "Design For Humans - Tier 2 Semantic UI Design Tokens (W3C DTCG Standard)",
  "transparency": {
    "default": {
      "$value": "50%"
    },
    "subtle": {
      "$value": "10%"
    },
    "quiet": {
      "$value": "33%"
    },
    "strong": {
      "$value": "70%"
    },
    "xstrong": {
      "$value": "90%"
    }
  },
  "color": {
    "$type": "color",
    "muted": {
      "$value": "color-mix(in srgb, currentColor, transparent {transparency.50})",
      "$description": "Semi-transparent muted tint based on current text color"
    },
    "focus": {
      "$value": "currentColor",
      "$description": "High-contrast focus ring stroke color (WCAG 2.4.7 & 2.4.13 >= 3:1)"
    },
    "quiet": {
      "$value": "color-mix(in srgb, currentColor, transparent {transparency.70})",
      "$description": "Low-contrast subtle tint for dividers and hair-lines"
    },
    "backdrop": {
      "$value": "color-mix(in srgb, {color.neutral.900}, transparent {transparency.50})",
      "$description": "Overlay scrim background for modal dialogs"
    },
    "overlay": {
      "$value": "light-dark(color-mix(in srgb, {color.neutral.000}, transparent {transparency.33}), color-mix(in srgb, {color.neutral.900}, transparent {transparency.33}))",
      "$description": "Translucent surface layer for sticky navigation and floating panels"
    }
  },
  "surface": {
    "$type": "color",
    "$description": "Surface and container background fills",
    "default": {
      "$value": "light-dark({color.neutral.000}, {color.neutral.900})",
      "$description": "Default canvas / page viewport background"
    },
    "subtle": {
      "$value": "light-dark({color.neutral.100}, {color.neutral.800})",
      "$description": "Default canvas / page viewport background"
    },
    "inverted": {
      "$value": "light-dark({color.neutral.800}, {color.neutral.000})",
      "$description": "Inverted contrast background for tooltips and contrast banners"
    },
    "card": {
      "$value": "light-dark({color.white}, {color.neutral.1000})",
      "$description": "Elevated card, dialog, popover, and panel background"
    },
    "dark": {
      "$value": "light-dark({color.neutral.800}, {color.neutral.1000})",
      "$description": "Dark container background for footer and media asides"
    },
    "darker": {
      "$value": "{color.neutral.1000}",
      "$description": "Maximum depth background for deep containers"
    },
    "accent": {
      "$value": "light-dark({color.aqua.200}, {color.aqua.700})",
      "$description": "Light tint accent surface for badges and highlighted areas"
    },
    "accent-dark": {
      "$value": "{color.aqua.800}",
      "$description": "Deep accent surface"
    },
    "accent-muted": {
      "$value": "light-dark({color.aqua.100}, {color.aqua.900})",
      "$description": "Very soft tint accent surface for hovered selections"
    },
    "accent-strong": {
      "$value": "light-dark({color.aqua.700}, {color.aqua.300})",
      "$description": "High-contrast accent surface for primary interactive elements"
    },
    "fade": {
      "$value": "light-dark(color-mix(in srgb, {color.neutral.900}, transparent {transparency.95}), color-mix(in srgb, {color.neutral.000}, transparent {transparency.90}))",
      "$description": "Gentle hover tint on interactive surfaces"
    },
    "hover": {
      "$value": "light-dark(color-mix(in srgb, {color.neutral.900}, transparent {transparency.90}), color-mix(in srgb, {color.neutral.000}, transparent {transparency.90}))",
      "$description": "Gentle hover tint on interactive surfaces"
    },
    "danger": {
      "$value": "light-dark({color.red.200}, {color.red.700})",
      "$description": "Destructive or error alert banner background"
    },
    "warning": {
      "$value": "light-dark({color.amber.100}, {color.amber.800})",
      "$description": "Cautionary or pending review alert banner background"
    },
    "success": {
      "$value": "light-dark({color.green.100}, {color.green.800})",
      "$description": "Positive feedback or completed status banner background"
    }
  },
  "foreground": {
    "$type": "color",
    "$description": "Text, typography, and icon color fills",
    "default": {
      "$value": "light-dark({color.neutral.800}, {color.neutral.000})",
      "$description": "High-contrast primary body copy and headings (WCAG AAA >= 7:1)"
    },
    "strong": {
      "$value": "light-dark({color.black}, {color.white})",
      "$description": "High-contrast primary body copy and headings (WCAG AAA >= 7:1)"
    },
    "inverted": {
      "$value": "light-dark({color.neutral.000}, {color.neutral.800})",
      "$description": "Text on inverted backgrounds"
    },
    "inverted-strong": {
      "$value": "light-dark({color.white}, {color.black})",
      "$description": "Text on inverted backgrounds"
    },
    "on-dark": {
      "$value": "{color.neutral.000}",
      "$description": "White/cream text on dark hero sections"
    },
    "muted": {
      "$value": "light-dark({color.neutral.700}, {color.neutral.300})",
      "$description": "Secondary subtext, timestamps, and captions (WCAG AA >= 4.5:1)"
    },
    "danger": {
      "$value": "light-dark({color.red.700}, {color.red.400})",
      "$description": "Destructive button text, form error messages"
    },
    "danger-hover": {
      "$value": "light-dark({color.red.600}, {color.red.500})",
      "$description": "Destructive button text, form error messages"
    },
    "danger-pressed": {
      "$value": "light-dark({color.red.800}, {color.red.300})",
      "$description": "Destructive button text, form error messages"
    },
    "warning": {
      "$value": "light-dark({color.amber.700}, {color.amber.300})",
      "$description": "Warning callout text and pending status icons"
    },
    "warning-hover": {
      "$value": "light-dark({color.amber.600}, {color.amber.400})",
      "$description": "Warning callout text and pending status icons"
    },
    "warning-pressed": {
      "$value": "light-dark({color.amber.800}, {color.amber.200})",
      "$description": "Warning callout text and pending status icons"
    },
    "success": {
      "$value": "light-dark({color.green.700}, {color.green.300})",
      "$description": "Success checkmark icons and completed status text"
    },
    "success-hover": {
      "$value": "light-dark({color.green.600}, {color.green.400})",
      "$description": "Success checkmark icons and completed status text"
    },
    "success-pressed": {
      "$value": "light-dark({color.green.800}, {color.green.200})",
      "$description": "Success checkmark icons and completed status text"
    },
    "accent": {
      "$value": "light-dark({color.aqua.700}, {color.aqua.300})",
      "$description": "Brand links, active navigation items, focus states"
    },
    "accent-hover": {
      "$value": "light-dark({color.aqua.600}, {color.aqua.400})",
      "$description": "Hover state for links and accent buttons"
    },
    "accent-pressed": {
      "$value": "light-dark({color.aqua.800}, {color.aqua.300})",
      "$description": "Active / pressed state for links and accent buttons"
    },
    "accent-inverted": {
      "$value": "light-dark({color.aqua.300}, {color.aqua.700})",
      "$description": "Accent link and interactive text on inverted background"
    },
    "accent-inverted-hover": {
      "$value": "light-dark({color.aqua.400}, {color.aqua.600})",
      "$description": "Accent link hover state on inverted background"
    },
    "accent-inverted-pressed": {
      "$value": "light-dark({color.aqua.200}, {color.aqua.800})",
      "$description": "Accent link active/pressed state on inverted background"
    },
    "accent-on-dark": {
      "$value": "{color.aqua.300}",
      "$description": "Accent link and interactive text on dark surfaces"
    },
    "accent-on-dark-hover": {
      "$value": "{color.aqua.400}",
      "$description": "Accent link hover state on dark surfaces"
    },
    "accent-on-dark-pressed": {
      "$value": "{color.aqua.200}",
      "$description": "Accent link active/pressed state on dark surfaces"
    }
  },
  "border": {
    "color": {
      "default": {
        "$value": "currentColor",
        "$type": "color",
        "$description": "Standard border stroke color"
      },
      "muted": {
        "$value": "{color.muted}",
        "$type": "color",
        "$description": "Muted border stroke color"
      },
      "quiet": {
        "$value": "{color.quiet}",
        "$type": "color",
        "$description": "Quiet border stroke color"
      },
      "accent": {
        "$value": "light-dark({color.aqua.400}, {color.aqua.600})",
        "$type": "color",
        "$description": "Active interactive border color"
      },
      "accent-strong": {
        "$value": "light-dark({color.aqua.600}, {color.aqua.400})",
        "$type": "color",
        "$description": "High-contrast accent border"
      },
      "danger": {
        "$value": "light-dark({color.red.600}, {color.red.400})",
        "$type": "color",
        "$description": "Invalid input field border"
      },
      "success": {
        "$value": "light-dark({color.green.600}, {color.green.400})",
        "$type": "color",
        "$description": "Valid input field border"
      }
    },
    "width": {
      "$value": "{border-width.2}",
      "$type": "dimension",
      "$description": "Standard border stroke thickness"
    },
    "default": {
      "$value": "{border.width} solid {border.color}",
      "$type": "border",
      "$description": "Standard border"
    },
    "muted": {
      "$value": "{border.width} solid {border.color.muted}",
      "$type": "border",
      "$description": "Muted border"
    },
    "quiet": {
      "$value": "{border.width} solid {border.color.quiet}",
      "$type": "border",
      "$description": "Quiet border"
    },
    "subtle": {
      "$value": "{border-width.1} dashed {border.color.quiet}",
      "$type": "border",
      "$description": "Dashed disclosure border"
    }
  },
  "opacity": {
    "$type": "number",
    "muted": {
      "$value": "{opacity.80}"
    },
    "disabled": {
      "$value": "{opacity.70}"
    }
  },
  "filter": {
    "blur": {
      "$value": "blur(4px)",
      "$type": "other",
      "$description": "Backdrop blur filter for glassmorphic layers"
    }
  },
  "site-width": {
    "$value": "{layout.site-width}",
    "$type": "dimension",
    "$description": "Standard site-width page constraint baseline"
  },
  "spacing": {
    "$type": "dimension",
    "default": {
      "$value": "{spacing.1}",
      "$description": "Standard 1rem layout spacing baseline"
    },
    "target": {
      "$value": "{spacing.3}",
      "$description": "Accessible interactive touch target size (48px / 3rem, WCAG 2.5.5 AAA)"
    },
    "target-sm": {
      "$value": "{spacing.2}",
      "$description": "Small interactive touch target size (24px / 1.5rem, WCAG 2.5.8 AA)"
    },
    "target-lg": {
      "$value": "{spacing.4}",
      "$description": "Large interactive touch target size (56px-64px / 4rem)"
    },
    "breathe": {
      "$value": "var(--spacing-fluid)",
      "$description": "Fluid breathing space between major container sections"
    },
    "cushion": {
      "$value": "var(--spacing-fluid-x2)",
      "$description": "Double fluid cushion space for outer page and hero margins"
    },
    "scroll-margin": {
      "$value": "1em",
      "$description": "Clearance above anchored heading targets"
    },
    "cq-breathe": {
      "$value": "var(--spacing-cq)",
      "$description": "Container-fluid breathing space using container query cqi units"
    },
    "cq-cushion": {
      "$value": "var(--spacing-cq-x2)",
      "$description": "Double container-fluid cushion space using container query cqi units"
    }
  },
