{
  "$description": "Design For Humans - Tier 2 Semantic UI Design Tokens (W3C DTCG Standard)",
  "translucency": {
    "default": {
      "$value": "{translucency.50}"
    },
    "subtle": {
      "$value": "{translucency.10}"
    },
    "quiet": {
      "$value": "{translucency.33}"
    },
    "strong": {
      "$value": "{translucency.70}"
    },
    "stronger": {
      "$value": "{translucency.90}"
    },
    "faint": {
      "$value": "{translucency.95}",
      "$description": "A surface barely tinted: the inverted surface mixed this far towards transparent (--surface-translucent)."
    }
  },
  "blur": {
    "sm": {
      "$value": "blur(2px)"
    },
    "md": {
      "$value": "blur(4px)"
    },
    "lg": {
      "$value": "blur(8px)"
    },
    "xl": {
      "$value": "blur(16px)"
    },
    "default": {
      "$value": "{blur.md}"
    }
  },
  "color": {
    "$type": "color",
    "muted": {
      "$value": "color-mix(in srgb, currentColor, transparent {translucency.50})",
      "$description": "Semi-transparent muted tint based on current text color"
    },
    "focus": {
      "$value": "currentColor",
      "$description": "High-contrast focus ring stroke color (WCAG 2.4.7 & 2.4.13 >= 3:1)"
    },
    "quiet": {
      "$value": "color-mix(in srgb, currentColor, transparent {translucency.70})",
      "$description": "Low-contrast subtle tint for dividers and hair-lines"
    },
    "backdrop": {
      "$value": "color-mix(in srgb, {color.neutral.900}, transparent {translucency.50})",
      "$description": "Overlay scrim background for modal dialogs"
    },
    "overlay": {
      "$value": "light-dark(color-mix(in srgb, {color.neutral.000}, transparent {translucency.33}), color-mix(in srgb, {color.neutral.900}, transparent {translucency.33}))",
      "$description": "Translucent surface layer for sticky navigation and floating panels"
    }
  },
  "surface-layer": {
    "filter": {
      "$value": "{blur.lg}",
      "$type": "other",
      "$description": "Backdrop blur filter for glassmorphic layers"
    },
    "translucency": {
      "$value": "{translucency.subtle}",
      "$type": "other",
      "$description": "Translucency for surface layer"
    }
  },
  "surface": {
    "$type": "color",
    "$description": "Surface and container background fills",
    "default": {
      "$value": "light-dark({color.neutral.000}, {color.neutral.1000})",
      "$description": "Default canvas / page viewport background"
    },
    "subtle": {
      "$value": "light-dark({color.neutral.000}, {color.neutral.1000})",
      "$description": "Default canvas / page viewport background"
    },
    "muted": {
      "$value": "light-dark({color.neutral.100}, {color.neutral.900})",
      "$description": "Subtle surface background for page canvas"
    },
    "inverted": {
      "$value": "light-dark({color.neutral.1000}, {color.neutral.000})",
      "$description": "Inverted contrast background for tooltips and contrast banners"
    },
    "card": {
      "$value": "light-dark({color.white}, {color.black})",
      "$description": "Elevated card, dialog, popover, and panel background"
    },
    "card-inverted": {
      "$value": "light-dark({color.black}, {color.white})",
      "$description": "Inverted contrast card, dialog, popover, and panel background"
    },
    "dark": {
      "$value": "light-dark({color.neutral.1000}, {color.black})",
      "$description": "Dark container background for footer and media asides"
    },
    "darker": {
      "$value": "{color.black}",
      "$description": "Maximum depth background for deep containers"
    },
    "layer": {
      "$value": "light-dark(color-mix(in srgb, {color.white}, transparent {surface-layer.translucency}), color-mix(in srgb, {color.black}, transparent {surface-layer.translucency}))",
      "$description": "Layer surface background for floating or sticky elements"
    },
    "accent": {
      "$value": "light-dark({color.purple.200}, {color.purple.800})",
      "$description": "Light tint accent surface for badges and highlighted areas"
    },
    "accent-dark": {
      "$value": "{color.purple.800}",
      "$description": "Deep accent surface"
    },
    "accent-strong": {
      "$value": "light-dark({color.purple.700}, {color.purple.300})",
      "$description": "High-contrast accent surface for primary interactive elements"
    },
    "complementary": {
      "$value": "light-dark({color.blue.200}, {color.blue.800})",
      "$description": "Light tint complementary surface for badges and highlighted areas"
    },
    "complementary-dark": {
      "$value": "{color.blue.800}",
      "$description": "Deep complementary surface"
    },
    "complementary-strong": {
      "$value": "light-dark({color.blue.700}, {color.blue.300})",
      "$description": "High-contrast complementary surface for primary interactive elements"
    },
    "translucent": {
      "$value": "color-mix(in srgb, {surface.inverted}, transparent {translucency.95})",
      "$description": "Gentle hover tint on interactive surfaces"
    },
    "translucent-strong": {
      "$value": "color-mix(in srgb, {surface.inverted}, transparent {translucency.90})",
      "$description": "Stronger hover tint on interactive surfaces"
    },
    "shade": {
      "$value": "light-dark(color-mix(in srgb, {color.neutral.1000}, transparent {translucency.95}), color-mix(in srgb, {color.black}, transparent {translucency.70}))",
      "$description": "Darker shade for gentle emphasis"
    },
    "danger": {
      "$value": "light-dark({color.red.100}, {color.red.900})",
      "$description": "Destructive or error alert banner background"
    },
    "danger-strong": {
      "$value": "light-dark({color.red.700}, {color.red.300})",
      "$description": "High-contrast danger surface for strong alert banners and callouts"
    },
    "warning": {
      "$value": "light-dark({color.amber.100}, {color.amber.900})",
      "$description": "Cautionary or pending review alert banner background"
    },
    "warning-strong": {
      "$value": "light-dark({color.amber.700}, {color.amber.300})",
      "$description": "High-contrast warning surface for strong alert banners and callouts"
    },
    "success": {
      "$value": "light-dark({color.green.100}, {color.green.900})",
      "$description": "Positive feedback or completed status banner background"
    },
    "success-strong": {
      "$value": "light-dark({color.green.700}, {color.green.300})",
      "$description": "High-contrast success surface for strong alert banners and callouts"
    },
    "info": {
      "$value": "light-dark({color.blue.100}, {color.blue.900})",
      "$description": "Cautionary or pending review alert banner background"
    },
    "info-strong": {
      "$value": "light-dark({color.blue.700}, {color.blue.300})",
      "$description": "High-contrast info surface for strong alert banners and callouts"
    }
  },
  "foreground": {
    "$type": "color",
    "$description": "Text, typography, and icon color fills",
    "default": {
      "$value": "light-dark({color.neutral.800}, {color.neutral.000})",
      "$description": "High-contrast primary body copy and headings (WCAG AAA >= 7:1)"
    },
    "strong": {
      "$value": "light-dark({color.black}, {color.white})",
      "$description": "High-contrast prominent copy"
    },
    "inverted": {
      "$value": "light-dark({color.neutral.000}, {color.neutral.800})",
      "$description": "Text on inverted backgrounds"
    },
    "inverted-strong": {
      "$value": "light-dark({color.white}, {color.black})",
      "$description": "Strong text on inverted backgrounds"
    },
    "on-dark": {
      "$value": "{color.neutral.000}",
      "$description": "Light text on dark hero sections"
    },
    "white": {
      "$value": "{color.white}",
      "$description": "Light text on dark hero sections"
    },
    "muted": {
      "$value": "light-dark({color.neutral.700}, {color.neutral.300})",
      "$description": "Secondary subtext, timestamps, and captions (WCAG AA >= 4.5:1)"
    },
    "accent": {
      "$value": "light-dark({color.purple.600}, {color.purple.300})",
      "$description": "Brand links, active navigation items, focus states"
    },
    "accent-hover": {
      "$value": "light-dark({color.purple.700}, {color.purple.200})",
      "$description": "Hover state for links and accent buttons"
    },
    "accent-pressed": {
      "$value": "light-dark({color.purple.800}, {color.purple.100})",
      "$description": "Active / pressed state for links and accent buttons"
    },
    "complementary": {
      "$value": "light-dark({color.blue.700}, {color.blue.300})",
      "$description": "Complementary links, active navigation items, focus states"
    },
    "complementary-hover": {
      "$value": "light-dark({color.blue.600}, {color.blue.200})",
      "$description": "Complementary state for links and accent buttons"
    },
    "complementary-pressed": {
      "$value": "light-dark({color.blue.800}, {color.blue.100})",
      "$description": "Active / pressed state for complementary buttons"
    },
    "danger": {
      "$value": "light-dark({color.red.600}, {color.red.300})",
      "$description": "Destructive button text, form error messages"
    },
    "danger-hover": {
      "$value": "light-dark({color.red.700}, {color.red.200})",
      "$description": "Destructive button hover state"
    },
    "danger-pressed": {
      "$value": "light-dark({color.red.800}, {color.red.100})",
      "$description": "Destructive button pressed state"
    },
    "success": {
      "$value": "light-dark({color.green.600}, {color.green.300})",
      "$description": "Success checkmark icons and completed status text"
    },
    "success-hover": {
      "$value": "light-dark({color.green.700}, {color.green.200})",
      "$description": "Success hover state"
    },
    "success-pressed": {
      "$value": "light-dark({color.green.800}, {color.green.100})",
      "$description": "Success pressed state"
    },
    "warning": {
      "$value": "light-dark({color.amber.600}, {color.amber.300})",
      "$description": "Warning callout text and pending status icons"
    },
    "warning-hover": {
      "$value": "light-dark({color.amber.700}, {color.amber.200})",
      "$description": "Warning hover state"
    },
    "warning-pressed": {
      "$value": "light-dark({color.amber.800}, {color.amber.100})",
      "$description": "Warning pressed state"
    },
    "info": {
      "$value": "light-dark({color.blue.600}, {color.blue.300})",
      "$description": "info callout text and pending status icons"
    },
    "info-hover": {
      "$value": "light-dark({color.blue.700}, {color.blue.200})",
      "$description": "info hover state"
    },
    "info-pressed": {
      "$value": "light-dark({color.blue.800}, {color.blue.100})",
      "$description": "info pressed state"
    }
  },
  "border": {
    "color": {
      "$type": "color",
      "$description": "Border color strokes",
      "default": {
        "$value": "currentColor",
        "$description": "Standard border stroke color"
      },
      "muted": {
        "$value": "{color.muted}",
        "$description": "Muted border stroke color"
      },
      "quiet": {
        "$value": "{color.quiet}",
        "$description": "Quiet border stroke color"
      },
      "control": {
        "$value": "color-mix(in srgb, currentColor, transparent {translucency.33})",
        "$description": "Form control boundary: 67% of the text colour, at least 3:1 against the page in both schemes (WCAG 1.4.11)"
      },
      "accent": {
        "$value": "{color.purple.500}",
        "$description": "Active interactive border color"
      },
      "complementary": {
        "$value": "light-dark({color.blue.600}, {color.blue.500})",
        "$description": "Complementary interactive border color"
      },
      "danger": {
        "$value": "{color.red.500}",
        "$description": "Invalid input field border"
      },
      "warning": {
        "$value": "{color.amber.500}",
        "$description": "Warning field border"
      },
      "success": {
        "$value": "{color.green.500}",
        "$description": "Valid input field border"
      },
      "info": {
        "$value": "{color.blue.500}",
        "$description": "info field border"
      }
    },
    "width": {
      "$type": "dimension",
      "$description": "Border stroke thicknesses",
      "medium": {
        "$value": "{border.width.2}",
        "$type": "dimension",
        "$description": "Medium border stroke thickness"
      },
      "thin": {
        "$value": "{border.width.1}",
        "$type": "dimension",
        "$description": "Thin border stroke thickness"
      },
      "thick": {
        "$value": "{border.width.4}",
        "$type": "dimension",
        "$description": "Thick border stroke thickness"
      },
      "default": {
        "$value": "{border.width.medium}",
        "$type": "dimension",
        "$description": "Standard border stroke thickness"
      }
    },
    "default": {
      "$value": "{border.width} solid {border.color}",
      "$type": "border",
      "$description": "Standard border"
    },
    "muted": {
      "$value": "{border.width} solid {border.color.muted}",
      "$type": "border",
      "$description": "Muted border"
    },
    "quiet": {
      "$value": "{border.width} solid {border.color.quiet}",
      "$type": "border",
      "$description": "Quiet border"
    },
    "subtle": {
      "$value": "{border.width.1} dashed {border.color.quiet}",
      "$type": "border",
      "$description": "Dashed disclosure border"
    }
  },
  "opacity": {
    "$type": "number",
    "muted": {
      "$value": "{opacity.80}"
    },
    "disabled": {
      "$value": "{opacity.50}"
    }
  },
  "site-width": {
    "$value": "{layout.site-width}",
    "$type": "dimension",
    "$description": "Standard site-width page constraint baseline"
  },
  "spacing": {
    "$type": "dimension",
    "default": {
      "$value": "{spacing.16}",
      "$description": "Standard 1rem layout spacing baseline"
    },
    "compact": {
      "$value": "{spacing.8}",
      "$type": "dimension",
      "$description": "Gap between items in a compact region (layout primitives step down to it)"
    },
    "2xs": {
      "$value": "{spacing.2}",
      "$type": "dimension",
      "$description": "Spacing step 2xs (2px): margin, padding and gap utilities"
    },
    "xs": {
      "$value": "{spacing.4}",
      "$type": "dimension",
      "$description": "Spacing step xs (4px): margin, padding and gap utilities"
    },
    "sm": {
      "$value": "{spacing.8}",
      "$type": "dimension",
      "$description": "Spacing step sm (8px): margin, padding and gap utilities"
    },
    "md": {
      "$value": "{spacing.16}",
      "$type": "dimension",
      "$description": "Spacing step md (16px): margin, padding and gap utilities"
    },
    "lg": {
      "$value": "{spacing.32}",
      "$type": "dimension",
      "$description": "Spacing step lg (32px): margin, padding and gap utilities"
    },
    "xl": {
      "$value": "{spacing.48}",
      "$type": "dimension",
      "$description": "Spacing step xl (48px): margin, padding and gap utilities"
    },
    "2xl": {
      "$value": "{spacing.64}",
      "$type": "dimension",
      "$description": "Spacing step 2xl (64px): margin, padding and gap utilities"
    },
    "3xl": {
      "$value": "{spacing.128}",
      "$type": "dimension",
      "$description": "Spacing step 3xl (128px): margin, padding and gap utilities"
    },
    "target": {
      "$value": "{spacing.48}",
      "$description": "Accessible interactive touch target size (48px / 3rem, WCAG 2.5.5 AAA)"
    },
    "target-sm": {
      "$value": "{spacing.32}",
      "$description": "Small interactive touch target size (24px / 1.5rem, WCAG 2.5.8 AA)"
    },
    "target-lg": {
      "$value": "{spacing.64}",
      "$description": "Large interactive touch target size (56px-64px / 4rem)"
    },
    "target-min": {
      "$value": "{spacing.target}",
      "$description": "Minimum hit area for every interactive control. Defaults to the 48px touch target; a product that opts into fine-pointer targets sets it to spacing.target-sm (PRINCIPLES §2)."
    },
    "block-2xs": {
      "$value": "{spacing.128}",
      "$description": "Smallest block spacing"
    },
    "block-xs": {
      "$value": "{spacing.256}",
      "$description": "Small block spacing (e.g. Popovers)"
    },
    "block-sm": {
      "$value": "{spacing.384}",
      "$description": "BrandMedium block spacing (e.g. Sidebars)"
    },
    "block": {
      "$value": "{spacing.576}",
      "$description": "Standard block spacing (e.g. Dialogs)"
    },
    "block-lg": {
      "$value": "{spacing.768}",
      "$description": "Large block spacing (e.g. Layouts)"
    },
    "block-xl": {
      "$value": "{spacing.1024}",
      "$description": "Extra Large block spacing"
    },
    "block-2xl": {
      "$value": "{spacing.1280}",
      "$description": "Largest block spacing (e.g. Site width)"
    },
    "breathe": {
      "$value": "{fluid.spacing.breathe}",
      "$description": "Fluid breathing space between major container sections"
    },
    "cushion": {
      "$value": "{fluid.spacing.cushion}",
      "$description": "Double fluid cushion space for outer page and hero margins"
    },
    "scroll-margin": {
      "$value": "1em",
      "$description": "Clearance above anchored heading targets"
    },
    "cq-breathe": {
      "$value": "{fluid.spacing.cq.breathe}",
      "$description": "Container-fluid breathing space using container query cqi units"
    },
    "cq-cushion": {
      "$value": "{fluid.spacing.cq.cushion}",
      "$description": "Double container-fluid cushion space using container query cqi units"
    },
    "breathe-sm": {
      "$value": "{fluid.spacing.breathe-sm}",
      "$description": "A smaller breathing space, for tighter groups"
    },
    "cq-breathe-sm": {
      "$value": "{fluid.spacing.cq.breathe-sm}",
      "$description": "A smaller breathing space, for tighter groups, growing with its container (cqi)"
