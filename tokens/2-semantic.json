        "inverted": {
          "$value": "light-dark({color.white}, {color.neutral.900})"
        },
        "on-dark": {
          "$value": "{color.white}"
        },
        "muted": {
          "$value": "light-dark({color.neutral.800}, {color.neutral.100})"
        },
        "accent-hover": {
          "$value": "light-dark({color.purple.700}, {color.purple.300})"
        }
      },
      "border": {
        "color": {
          "accent": {
            "$value": "{color.purple.500}"
          },
          "accent-strong": {
            "$value": "{color.purple.500}"
          },
          "muted": {
            "$value": "currentColor"
          },
          "quiet": {
            "$value": "{color.muted}"
          }
        }
      },
      "opacity": {
        "muted": {
          "$value": "{opacity.90}"
        }
      }
    },
    "(prefers-reduced-motion: reduce)": {
      "duration": {
        "sm": {
          "$value": "{duration.0}"
        },
        "md": {
          "$value": "{duration.0}"
        },
        "lg": {
          "$value": "{duration.0}"
        },
        "xl": {
          "$value": "{duration.0}"
        }
      }
    }
  },
  "micro-heading-fluid": {
    "font-size": {
      "$value": "{fluid.typography.font-size.minus-1}",
      "$type": "dimension"
    }
  },
  "micro-heading-cq": {
    "font-size": {
      "$value": "{typography.font-size.cq.-1}",
      "$type": "dimension"
    }
  }
}