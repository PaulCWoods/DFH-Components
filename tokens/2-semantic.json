  "underline": {
    "offset": {
      "$value": "{border-width.4}",
      "$type": "dimension"
    },
    "thickness": {
      "$value": "{border-width.1}",
      "$type": "dimension"
    },
    "color": {
      "$value": "{color.muted}",
      "$type": "color"
    }
  },
  "code": {
    "font-family": {
      "$value": "{typography.font-family.mono}",
      "$type": "fontFamilies"
    },
    "font-weight": {
      "$value": "{body.font-weight}",
      "$type": "fontWeight"
    }
  },
  "script": {
    "font-size": {
      "$value": "{typography.font-size.minus-1}",
      "$type": "dimension"
    }
  },
  "focus-ring": {
    "width": {
      "$value": "{border-width.2}",
      "$type": "dimension"
    },
    "outline": {
      "$value": "{focus-ring.width} solid {color.focus}",
      "$type": "border",
      "$description": "Mandatory high-contrast focus ring outline (WCAG 2.4.7 & 2.4.13)"
    },
    "outline-offset": {
      "$value": "{border-width.2}",
      "$type": "dimension"
    },
    "clearance": {
      "$value": "calc({focus-ring.width} + {border-width.2})",
      "$type": "dimension"
    }
  },
  "duration": {
    "$type": "duration",
    "none": {
      "$value": "{duration.0}"
    },
    "sm": {
      "$value": "{duration.02}"
    },
    "md": {
      "$value": "{duration.05}"
    },
    "lg": {
      "$value": "{duration.1}"
    },
    "xl": {
      "$value": "{duration.2}"
    }
  },
  "timefunc": {
    "$type": "other",
    "ease-in-out": {
      "$value": "ease-in-out"
    },
    "ease-in": {
      "$value": "ease-in"
    },
    "ease-out": {
      "$value": "ease-out"
    },
    "linear": {
      "$value": "linear"
    }
  },
  "shadow": {
    "$type": "shadow",
    "color": {
      "$value": "light-dark(color-mix(in srgb, {color.neutral.900}, transparent 90%), color-mix(in srgb, {color.black}, transparent 80%))",
      "$type": "color",
      "$description": "Elevation shadow color tint"
    },
    "none": {
      "$value": "0 0 0 0 transparent",
      "$description": "No shadow elevation"
    },
    "sm": {
      "$type": "boxShadow",
      "$value": [
        {
          "x": "0",
          "y": "0",
          "blur": "1px",
          "spread": "0",
          "color": "{shadow.color}"
        },
        {
          "x": "0",
          "y": "1px",
          "blur": "2px",
          "spread": "0",
          "color": "{shadow.color}"
        },
        {
          "x": "0",
          "y": "2px",
          "blur": "6px",
          "spread": "0",
          "color": "{shadow.color}"
        }
      ],
      "$description": "Subtle card & resting surface stacked elevation"
    },
    "md": {
      "$type": "boxShadow",
      "$value": [
        {
          "x": "0",
          "y": "1px",
          "blur": "4px",
          "spread": "0",
          "color": "{shadow.color}"
        },
        {
          "x": "0",
          "y": "2px",
          "blur": "8px",
          "spread": "0",
          "color": "{shadow.color}"
        },
        {
          "x": "0",
          "y": "8px",
          "blur": "24px",
          "spread": "0",
          "color": "{shadow.color}"
        }
      ],
      "$description": "Medium stacked elevation for popovers and hover states"
    },
    "lg": {
      "$type": "boxShadow",
      "$value": [
        {
          "x": "0",
          "y": "4px",
          "blur": "16px",
          "spread": "0",
          "color": "{shadow.color}"
        },
        {
          "x": "0",
          "y": "8px",
          "blur": "32px",
          "spread": "0",
          "color": "{shadow.color}"
        },
        {
          "x": "0",
          "y": "16px",
          "blur": "64px",
          "spread": "0",
          "color": "{shadow.color}"
        }
      ],
      "$description": "High stacked elevation for modals, flyouts, and floating overlays"
    },
    "inner": {
      "$type": "boxShadow",
      "$value": [
        {
          "x": "0",
          "y": "1px",
          "blur": "2px",
          "spread": "0",
          "color": "{shadow.color}",
          "type": "innerShadow"
        },
        {
          "x": "0",
          "y": "2px",
          "blur": "4px",
          "spread": "0",
          "color": "{shadow.color}",
          "type": "innerShadow"
        },
        {
          "x": "0",
          "y": "4px",
          "blur": "8px",
          "spread": "0",
          "color": "{shadow.color}",
          "type": "innerShadow"
        }
      ],
      "$description": "Inset stacked shadow for wells and pressed states"
    },
    "inset": {
      "$value": "{shadow.inner}",
      "$description": "Alias for inner inset shadow"
    },
    "default": {
      "$value": "{shadow.sm}",
      "$description": "Standard resting surface shadow"
    },
    "raised": {
      "$value": "{shadow.md}",
      "$description": "Elevated hover or focused surface shadow"
    },
    "reset": {
      "$value": "{shadow.none}",
      "$description": "Shadow reset for active or flat states"
    }
  },
  "z-index": {
    "$type": "number",
    "deep": {
      "$value": "{z-index.minus-1}"
    },
    "base": {
      "$value": "{z-index.0}"
    },
    "sticky": {
      "$value": "{z-index.100}"
    },
    "overlay": {
      "$value": "{z-index.300}"
    },
    "dialog": {
      "$value": "{z-index.400}"
    },
    "popover": {
      "$value": "{z-index.500}"
    },
    "toast": {
      "$value": "{z-index.600}"
    },
    "tooltip": {
      "$value": "{z-index.700}"
    }
  },
  "$media": {
    "(prefers-contrast: more)": {
      "surface": {
        "dark": {
          "$value": "light-dark({color.neutral.900}, {color.neutral.1000})"
        },
        "default": {
          "$value": "light-dark({color.white}, {color.neutral.1000})"
        },
        "inverted": {
          "$value": "light-dark({color.neutral.900}, {color.white})"
        }
      },
      "foreground": {
        "default": {
          "$value": "light-dark({color.neutral.900}, {color.white})"
        },
        "inverted": {
          "$value": "light-dark({color.white}, {color.neutral.900})"
        },
        "on-dark": {
          "$value": "{color.white}"
        },
        "muted": {
          "$value": "light-dark({color.neutral.800}, {color.neutral.100})"
        },
        "accent-hover": {
          "$value": "light-dark({color.aqua.700}, {color.aqua.300})"
        }
      },
      "border": {
        "color": {
          "accent": {
            "$value": "{color.aqua.500}"
          },
          "accent-strong": {
            "$value": "{color.aqua.500}"
          },
          "muted": {
            "$value": "currentColor"
          },
          "quiet": {
            "$value": "{color.muted}"
          }
        }
      },
      "opacity": {
        "muted": {
          "$value": "{opacity.90}"
        }
      }
    },
    "(prefers-reduced-motion: reduce)": {
      "duration": {
        "sm": {
          "$value": "{duration.0}"
        },
        "md": {
          "$value": "{duration.0}"
        },
        "lg": {
          "$value": "{duration.0}"
        },
        "xl": {
          "$value": "{duration.0}"
        }
      }
    }
  }
}