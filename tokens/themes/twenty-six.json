{
  "$schema": "https://components.designforhumans.blog/schema/theme-v1.schema.json",
  "version": 1,
  "$description": "Twenty-six: warm paper and ink, a copper accent, Geist with Instrument Serif titles, pill Buttons and bordered Cards. Link themes/twenty-six.css after the library.",
  "curve": "soft-s",
  "ends": {
    "light": 0.955,
    "dark": 0.27
  },
  "chroma": {
    "light": 0.45,
    "dark": 0.65
  },
  "fixed": {
    "white": "#ffffff",
    "black": "#121212"
  },
  "hues": {
    "neutral": {
      "seed": "#f0efeb",
      "outside": {
        "1000": 0.04,
        "000": 0.02
      },
      "ends": {
        "light": 0.965
      }
    },
    "teal": {
      "seed": "#2e6364"
    },
    "sage": {
      "seed": "#7f8a72"
    },
    "amber": {
      "seed": "#e0a526"
    },
    "green": {
      "seed": "#4f8a5b"
    },
    "red": {
      "seed": "#d1453b"
    },
    "blue": {
      "seed": "#4f7f95"
    }
  },
  "roles": {
    "surface.default": {
      "light": "neutral.000",
      "dark": "neutral.1000"
    },
    "surface.subtle": {
      "light": "neutral.000",
      "dark": "neutral.1000"
    },
    "surface.muted": {
      "light": "neutral.100",
      "dark": "neutral.900"
    },
    "surface.inverted": {
      "light": "neutral.1000",
      "dark": "neutral.000"
    },
    "surface.card": {
      "light": "white",
      "dark": "black"
    },
    "surface.card-inverted": {
      "light": "black",
      "dark": "white"
    },
    "surface.dark": {
      "light": "neutral.1000",
      "dark": "black"
    },
    "surface.darker": {
      "light": "black",
      "dark": "black"
    },
    "surface.accent": {
      "light": "teal.200",
      "dark": "teal.800"
    },
    "surface.accent-dark": {
      "light": "teal.800",
      "dark": "teal.800"
    },
    "surface.accent-strong": {
      "light": "teal.700",
      "dark": "teal.300"
    },
    "surface.complementary": {
      "light": "sage.200",
      "dark": "sage.800"
    },
    "surface.complementary-dark": {
      "light": "sage.800",
      "dark": "sage.800"
    },
    "surface.complementary-strong": {
      "light": "sage.700",
      "dark": "sage.300"
    },
    "surface.danger": {
      "light": "red.100",
      "dark": "red.900"
    },
    "surface.danger-strong": {
      "light": "red.700",
      "dark": "red.300"
    },
    "surface.warning": {
      "light": "amber.100",
      "dark": "amber.900"
    },
    "surface.info": {
      "light": "blue.100",
      "dark": "blue.900"
    },
    "surface.warning-strong": {
      "light": "amber.700",
      "dark": "amber.300"
    },
    "surface.info-strong": {
      "light": "blue.700",
      "dark": "blue.300"
    },
    "surface.success": {
      "light": "green.100",
      "dark": "green.900"
    },
    "surface.success-strong": {
      "light": "green.700",
      "dark": "green.300"
    },
    "foreground.default": {
      "light": "neutral.800",
      "dark": "neutral.000"
    },
    "foreground.strong": {
      "light": "black",
      "dark": "white"
    },
    "foreground.inverted": {
      "light": "neutral.000",
      "dark": "neutral.800"
    },
    "foreground.inverted-strong": {
      "light": "white",
      "dark": "black"
    },
    "foreground.on-dark": {
      "light": "neutral.000",
      "dark": "neutral.000"
    },
    "foreground.white": {
      "light": "white",
      "dark": "white"
    },
    "foreground.muted": {
      "light": "neutral.600",
      "dark": "neutral.400"
    },
    "foreground.accent": {
      "light": "teal.600",
      "dark": "teal.300"
    },
    "foreground.accent-hover": {
      "light": "teal.700",
      "dark": "teal.200"
    },
    "foreground.accent-pressed": {
      "light": "teal.800",
      "dark": "teal.100"
    },
    "foreground.complementary": {
      "light": "sage.700",
      "dark": "sage.300"
    },
    "foreground.complementary-hover": {
      "light": "sage.600",
      "dark": "sage.200"
    },
    "foreground.complementary-pressed": {
      "light": "sage.800",
      "dark": "sage.100"
    },
    "foreground.danger": {
      "light": "red.600",
      "dark": "red.300"
    },
    "foreground.danger-hover": {
      "light": "red.700",
      "dark": "red.200"
    },
    "foreground.danger-pressed": {
      "light": "red.800",
      "dark": "red.100"
    },
    "foreground.success": {
      "light": "green.600",
      "dark": "green.300"
    },
    "foreground.success-hover": {
      "light": "green.700",
      "dark": "green.200"
    },
    "foreground.success-pressed": {
      "light": "green.800",
      "dark": "green.100"
    },
    "foreground.warning": {
      "light": "amber.600",
      "dark": "amber.300"
    },
    "foreground.info": {
      "light": "blue.600",
      "dark": "blue.300"
    },
    "foreground.warning-hover": {
      "light": "amber.700",
      "dark": "amber.200"
    },
    "foreground.info-hover": {
      "light": "blue.700",
      "dark": "blue.200"
    },
    "foreground.warning-pressed": {
      "light": "amber.800",
      "dark": "amber.100"
    },
    "foreground.info-pressed": {
      "light": "blue.800",
      "dark": "blue.100"
    },
    "border.color.accent": {
      "light": "teal.500",
      "dark": "teal.500"
    },
    "border.color.complementary": {
      "light": "sage.600",
      "dark": "sage.500"
    },
    "border.color.danger": {
      "light": "red.500",
      "dark": "red.500"
    },
    "border.color.warning": {
      "light": "amber.500",
      "dark": "amber.500"
    },
    "border.color.info": {
      "light": "blue.500",
      "dark": "blue.500"
    },
    "border.color.success": {
      "light": "green.500",
      "dark": "green.500"
    }
  },
  "type": {
    "fonts": {
      "geist-mono": {
        "source": "google",
        "family": "Geist Mono",
        "axes": {
          "wght": [
            100,
            900
          ]
        },
        "fallback": "ui-monospace, Menlo, Monaco, Consolas, \"Liberation Mono\", monospace",
        "figma": "Geist Mono"
      },
      "quattrocento": {
        "source": "google",
        "family": "Quattrocento",
        "weights": [
          400,
          700
        ],
        "fallback": "Georgia, Cambria, \"Times New Roman\", Times, serif"
      },
      "libre-franklin": {
        "source": "google",
        "family": "Libre Franklin",
        "weights": [
          400,
          600,
          700
        ],
        "fallback": "system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif"
      }
    },
    "families": {
      "sans": {
        "font": "libre-franklin"
      },
      "serif": {
        "font": "quattrocento"
      },
      "mono": {
        "font": "geist-mono"
      },
      "display": {
        "font": "quattrocento"
      }
    },
    "scale": {
      "base": "1rem",
      "min": "0.75rem",
      "ratio": 1.2,
      "steps": [
        -2,
        8
      ],
      "ceiling": {
        "upper": "7.25rem"
      }
    },
    "leading": {
      "base": 1.6,
      "ratio": 1.125,
      "steps": [
        -5,
        1
      ]
    },
    "fluid": {
      "viewports": [
        "25rem",
        "80rem"
      ],
      "max": {
        "base": "1.5rem",
        "ratio": 1.25
      }
    },
    "styles": {
      "display-title": {
        "family": "display",
        "weight": "regular",
        "letterSpacing": "normal",
        "case": "none",
        "size": 6,
        "compact": 5,
        "leading": -4
      },
      "title": {
        "family": "display",
        "weight": "bold",
        "letterSpacing": "normal",
        "case": "none",
        "size": 5,
        "compact": 4,
        "leading": -3
      },
      "heading": {
        "family": "sans",
        "weight": "bold",
        "letterSpacing": "compact",
        "case": "none",
        "size": 2,
        "compact": 1,
        "leading": -3
      },
      "subheading": {
        "family": "sans",
        "weight": "bold",
        "letterSpacing": "normal",
        "size": 1,
        "compact": 0,
        "leading": -2
      },
      "small-heading": {
        "family": "sans",
        "weight": "bold",
        "letterSpacing": "normal",
        "case": "none",
        "size": 0,
        "compact": -1,
        "leading": -1
      },
      "micro-heading": {
        "family": "sans",
        "weight": "medium",
        "letterSpacing": "loose",
        "case": "uppercase",
        "size": -1,
        "compact": -2,
        "leading": -3
      },
      "body-lg": {
        "size": 1,
        "compact": 0,
        "leading": -1
      },
      "body": {
        "family": "sans",
        "weight": "regular",
        "size": 0,
        "compact": -1,
        "leading": 0
      },
      "body-sm": {
        "size": -1,
        "compact": -2,
        "leading": -1
      },
      "body-xs": {
        "size": -2,
        "compact": -2,
        "leading": -2
      },
      "label": {
        "family": "sans",
        "weight": "bold",
        "size": 0,
        "sizeOnStyle": true,
        "compact": -1,
        "fluid": false,
        "leading": -1
      },
      "code": {
        "family": "mono",
        "weight": "regular"
      },
      "body-alt": {
        "family": "serif"
      },
      "body-strong": {
        "weight": "bold"
      }
    },
    "controls": {
      "control": {
        "size": 0,
        "leading": -2
      },
      "control-sm": {
        "size": -1,
        "leading": -2
      },
      "control-lg": {
        "size": 2,
        "leading": -2
      }
    }
  },
  "space": {
    "base": "1rem",
    "ratio": 1.333333,
    "roles": {
      "breathe-sm": {
        "from": "0.75rem",
        "step": 0
      },
      "breathe": {
        "step": 1
      },
      "cushion": {
        "step": 2
      },
      "cushion-lg": {
        "step": 3
      }
    },
    "site-width": "75rem",
    "targets": {
      "sm": 32,
      "default": 48,
      "lg": 64
    },
    "app": {
      "padding-inline": "cushion",
      "sidebar-width": 288,
      "sidebar-compact-width": 192
    }
  },
  "shape": {
    "radius": {
      "sm": 4,
      "md": 8,
      "lg": 12,
      "xl": 16,
      "default": "lg"
    },
    "border": {
      "thin": 1,
      "medium": 2,
      "thick": 4,
      "default": "thin"
    },
    "shadow": {
      "color": {
        "light": {
          "color": "neutral.900",
          "transparent": 90
        },
        "dark": {
          "color": "black",
          "transparent": 25
        }
      },
      "color-light": {
        "light": {
          "color": "neutral.800",
          "transparent": 95
        },
        "dark": {
          "color": "black",
          "transparent": 50
        }
      },
      "levels": {
        "sm": {
          "layers": [
            {
              "y": 0,
              "blur": 1,
              "spread": 0
            },
            {
              "y": 1,
              "blur": 2,
              "spread": 0
            },
            {
              "y": 2,
              "blur": 6,
              "spread": 0
            }
          ]
        },
        "md": {
          "layers": [
            {
              "y": 1,
              "blur": 4,
              "spread": 0
            },
            {
              "y": 2,
              "blur": 8,
              "spread": 0
            },
            {
              "y": 8,
              "blur": 24,
              "spread": 0
            }
          ]
        },
        "lg": {
          "layers": [
            {
              "y": 4,
              "blur": 16,
              "spread": 0
            },
            {
              "y": 8,
              "blur": 32,
              "spread": 0
            },
            {
              "y": 16,
              "blur": 64,
              "spread": 0
            }
          ]
        },
        "inner": {
          "inset": true,
          "layers": [
            {
              "y": 1,
              "blur": 2,
              "spread": 0
            },
            {
              "y": 2,
              "blur": 4,
              "spread": 0
            },
            {
              "y": 4,
              "blur": 8,
              "spread": 0
            }
          ]
        }
      }
    },
    "lines": {
      "rule": {
        "width": "thin",
        "color": "border.color.quiet",
        "style": "solid"
      },
      "panel": {
        "width": "none",
        "color": "border.color.quiet",
        "style": "solid",
        "radius": "md"
      },
      "app": {
        "width": "none",
        "color": "border.color.quiet",
        "style": "solid"
      },
      "control": {
        "width": "default",
        "color": "border.color.control"
      },
      "tag": {
        "width": "thin",
        "color": "border.color.muted",
        "radius": "full"
      },
      "underline": {
        "width": "thin",
        "color": "color.muted",
        "offset": "thick"
      },
      "focus-ring": {
        "width": "medium",
        "color": "color.focus",
        "offset": "medium"
      }
    }
  },
  "components": {
    "button.radius": "{radius.lg}",
    "card.radius": "{radius.xl}",
    "dialog.radius": "{radius.xl}",
    "poster.content-radius": "{radius.xl}",
    "header.bg": "{surface.subtle}",
    "footer.bg": "{surface.subtle}",
    "sidebar.bg": "{surface.subtle}",
    "poster.content-padding": "{spacing.cushion}",
    "footer.padding-block": "{spacing.cushion-lg}",
    "header.padding-block": "{spacing.breathe}",
    "brand.letter-spacing": "{typography.spacing.normal}",
    "brand.font-weight": "{font-weight.semibold}",
    "chip.radius": "{radius.full}",
    "status.radius": "{radius.full}",
    "brand.font-family": "{typography.font-family.serif}",
    "brand.font-size": "{typography.font-size.1}",
    "brand.mark-size": "{spacing.32}",
    "poster.font-sizing": "cq",
    "button.padding-inline": "{spacing.20}",
    "badge.padding-inline": "{spacing.6}",
    "status.padding-inline": "{spacing.10}",
    "chip.padding-inline": "{spacing.10}",
    "button.sm.padding-inline": "{spacing.12}",
    "banner.border-width": "{border.width.none}",
    "telemetry.radius": "{radius.md}",
    "telemetry.border-width": "{border.width.none}",
    "telemetry.bg": "{surface.muted}"
  },
  "mixes": {
    "color.muted": {
      "light": {
        "color": "currentColor",
        "transparent": 50
      },
      "dark": {
        "color": "currentColor",
        "transparent": 50
      }
    },
    "color.quiet": {
      "light": {
        "color": "currentColor",
        "transparent": 70
      },
      "dark": {
        "color": "currentColor",
        "transparent": 70
      }
    },
    "color.focus": {
      "light": {
        "color": "currentColor",
        "transparent": 0
      },
      "dark": {
        "color": "currentColor",
        "transparent": 0
      }
    },
    "color.backdrop": {
      "light": {
        "color": "neutral.900",
        "transparent": 50
      },
      "dark": {
        "color": "black",
        "transparent": 50
      }
    },
    "color.overlay": {
      "light": {
        "color": "neutral.000",
        "transparent": 33
      },
      "dark": {
        "color": "neutral.900",
        "transparent": 33
      }
    },
    "surface.layer": {
      "light": {
        "color": "white",
        "transparent": 10
      },
      "dark": {
        "color": "black",
        "transparent": 10
      }
    },
    "surface.translucent": {
      "light": {
        "color": "surface.inverted",
        "transparent": 95
      },
      "dark": {
        "color": "surface.inverted",
        "transparent": 95
      }
    },
    "surface.translucent-strong": {
      "light": {
        "color": "surface.inverted",
        "transparent": 90
      },
      "dark": {
        "color": "surface.inverted",
        "transparent": 90
      }
    },
    "surface.shade": {
      "light": {
        "color": "neutral.1000",
        "transparent": 95
      },
      "dark": {
        "color": "black",
        "transparent": 70
      }
    },
    "border.color.default": {
      "light": {
        "color": "currentColor",
        "transparent": 0
      },
      "dark": {
        "color": "currentColor",
        "transparent": 0
      }
    },
    "border.color.muted": {
      "light": {
        "color": "color.muted",
        "transparent": 0
      },
      "dark": {
        "color": "color.muted",
        "transparent": 0
      }
    },
    "border.color.quiet": {
      "light": {
        "color": "color.quiet",
        "transparent": 0
      },
      "dark": {
        "color": "color.quiet",
        "transparent": 0
      }
    },
    "border.color.control": {
      "light": {
        "color": "currentColor",
        "transparent": 33
      },
      "dark": {
        "color": "currentColor",
        "transparent": 33
      }
    }
  },
  "motion": {
    "duration": {
      "sm": 0.15,
      "md": 0.3,
      "lg": 0.6,
      "xl": 1.2
    },
    "ease": {
      "in-out": "cubic-bezier(0.65, 0, 0.35, 1)",
      "in": "cubic-bezier(0.55, 0, 1, 0.45)",
      "out": "cubic-bezier(0.16, 1, 0.3, 1)",
      "bounce": "cubic-bezier(0.34, 1.56, 0.64, 1)"
    }
  },
  "contrast": {
    "steps": 1,
    "extra": {
      "opacity.muted": "{opacity.90}"
    }
  }
}
