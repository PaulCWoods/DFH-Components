{
  "$schema": "https://components.designforhumans.blog/schema/theme-v1.schema.json",
  "version": 1,
  "$description": "A theme, copied from starter: link themes/eden.css after the library.",
  "curve": "soft-s",
  "ends": {
    "light": 0.955,
    "dark": 0.27
  },
  "chroma": {
    "light": 0.45,
    "dark": 0.65
  },
  "fixed": {
    "white": "#ffffff",
    "black": "#121212"
  },
  "hues": {
    "neutral": {
      "seed": "#fefae0",
      "outside": {
        "1000": 0.04,
        "000": 0.02
      },
      "curve": "soft-s",
      "ends": {
        "light": 0.945
      }
    },
    "ocre": {
      "seed": "#86674b"
    },
    "olive": {
      "seed": "#656d4a"
    },
    "amber": {
      "seed": "#f3de2c"
    },
    "green": {
      "seed": "#6a994e"
    },
    "red": {
      "seed": "#ee6055"
    },
    "teal": {
      "seed": "#75969f"
    }
  },
  "roles": {
    "surface.default": {
      "light": "neutral.000",
      "dark": "neutral.1000"
    },
    "surface.subtle": {
      "light": "neutral.000",
      "dark": "neutral.1000"
    },
    "surface.muted": {
      "light": "neutral.100",
      "dark": "neutral.900"
    },
    "surface.inverted": {
      "light": "neutral.1000",
      "dark": "neutral.000"
    },
    "surface.card": {
      "light": "white",
      "dark": "black"
    },
    "surface.card-inverted": {
      "light": "black",
      "dark": "white"
    },
    "surface.dark": {
      "light": "neutral.1000",
      "dark": "black"
    },
    "surface.darker": {
      "light": "black",
      "dark": "black"
    },
    "surface.accent": {
      "light": "ocre.200",
      "dark": "ocre.800"
    },
    "surface.accent-dark": {
      "light": "ocre.800",
      "dark": "ocre.800"
    },
    "surface.accent-strong": {
      "light": "ocre.700",
      "dark": "ocre.300"
    },
    "surface.complementary": {
      "light": "olive.200",
      "dark": "olive.800"
    },
    "surface.complementary-dark": {
      "light": "olive.800",
      "dark": "olive.800"
    },
    "surface.complementary-strong": {
      "light": "olive.700",
      "dark": "olive.300"
    },
    "surface.danger": {
      "light": "red.100",
      "dark": "red.900"
    },
    "surface.danger-strong": {
      "light": "red.700",
      "dark": "red.300"
    },
    "surface.warning": {
      "light": "amber.100",
      "dark": "amber.900"
    },
    "surface.info": {
      "light": "teal.100",
      "dark": "teal.900"
    },
    "surface.warning-strong": {
      "light": "amber.700",
      "dark": "amber.300"
    },
    "surface.info-strong": {
      "light": "teal.700",
      "dark": "teal.300"
    },
    "surface.success": {
      "light": "green.100",
      "dark": "green.900"
    },
    "surface.success-strong": {
      "light": "green.700",
      "dark": "green.300"
    },
    "foreground.default": {
      "light": "neutral.800",
      "dark": "neutral.000"
    },
    "foreground.strong": {
      "light": "black",
      "dark": "white"
    },
    "foreground.inverted": {
      "light": "neutral.000",
      "dark": "neutral.800"
    },
    "foreground.inverted-strong": {
      "light": "white",
      "dark": "black"
    },
    "foreground.on-dark": {
      "light": "neutral.000",
      "dark": "neutral.000"
    },
    "foreground.white": {
      "light": "white",
      "dark": "white"
    },
    "foreground.muted": {
      "light": "neutral.600",
      "dark": "neutral.400"
    },
    "foreground.accent": {
      "light": "ocre.600",
      "dark": "ocre.300"
    },
    "foreground.accent-hover": {
      "light": "ocre.700",
      "dark": "ocre.200"
    },
    "foreground.accent-pressed": {
      "light": "ocre.800",
      "dark": "ocre.100"
    },
    "foreground.complementary": {
      "light": "olive.700",
      "dark": "olive.300"
    },
    "foreground.complementary-hover": {
      "light": "olive.600",
      "dark": "olive.200"
    },
    "foreground.complementary-pressed": {
      "light": "olive.800",
      "dark": "olive.100"
    },
    "foreground.danger": {
      "light": "red.600",
      "dark": "red.300"
    },
    "foreground.danger-hover": {
      "light": "red.700",
      "dark": "red.200"
    },
    "foreground.danger-pressed": {
      "light": "red.800",
      "dark": "red.100"
    },
    "foreground.success": {
      "light": "green.600",
      "dark": "green.300"
    },
    "foreground.success-hover": {
      "light": "green.700",
      "dark": "green.200"
    },
    "foreground.success-pressed": {
      "light": "green.800",
      "dark": "green.100"
    },
    "foreground.warning": {
      "light": "amber.600",
      "dark": "amber.300"
    },
    "foreground.info": {
      "light": "teal.600",
      "dark": "teal.300"
    },
    "foreground.warning-hover": {
      "light": "amber.700",
      "dark": "amber.200"
    },
    "foreground.info-hover": {
      "light": "teal.700",
      "dark": "teal.200"
    },
    "foreground.warning-pressed": {
      "light": "amber.800",
      "dark": "amber.100"
    },
    "foreground.info-pressed": {
      "light": "teal.800",
      "dark": "teal.100"
    },
    "border.color.accent": {
      "light": "ocre.500",
      "dark": "ocre.500"
    },
    "border.color.complementary": {
      "light": "olive.600",
      "dark": "olive.500"
    },
    "border.color.danger": {
      "light": "red.500",
      "dark": "red.500"
    },
    "border.color.warning": {
      "light": "amber.500",
      "dark": "amber.500"
    },
    "border.color.info": {
      "light": "teal.500",
      "dark": "teal.500"
    },
    "border.color.success": {
      "light": "green.500",
      "dark": "green.500"
    }
  },
  "type": {
    "fonts": {
      "libre-baskerville": {
        "source": "google",
        "family": "Libre Baskerville",
        "axes": {
          "wght": [
            400,
            700
          ]
        },
        "fallback": "Georgia, Cambria, \"Times New Roman\", Times, serif"
      },
      "cabin": {
        "source": "google",
        "family": "Cabin",
        "axes": {
          "wght": [
            400,
            700
          ]
        },
        "italic": true,
        "fallback": "system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif",
        "figma": "Cabin"
      }
    },
    "families": {
      "sans": {
        "font": "cabin"
      },
      "serif": {
        "font": "libre-baskerville"
      },
      "mono": {
        "system": "monospace"
      },
      "display": {
        "font": "libre-baskerville"
      }
    },
    "scale": {
      "base": "1rem",
      "min": "0.75rem",
      "ratio": 1.2,
      "steps": [
        -2,
        8
      ],
      "ceiling": {
        "upper": "7.25rem"
      }
    },
    "leading": {
      "base": 1.6,
      "ratio": 1.125,
      "steps": [
        -5,
        1
      ]
    },
    "fluid": {
      "viewports": [
        "25rem",
        "80rem"
      ],
      "max": {
        "base": "1.5rem",
        "ratio": 1.25
      }
    },
    "styles": {
      "display-title": {
        "family": "display",
        "weight": "regular",
        "letterSpacing": "normal",
        "case": "none",
        "size": 6,
        "compact": 5,
        "leading": -4,
        "growTo": 8
      },
      "title": {
        "family": "serif",
        "weight": "heavy",
        "letterSpacing": "normal",
        "case": "none",
        "size": 4,
        "compact": 3,
        "leading": -3
      },
      "heading": {
        "family": "sans",
        "weight": "bold",
        "letterSpacing": "normal",
        "case": "none",
        "size": 2,
        "compact": 1,
        "leading": -3
      },
      "subheading": {
        "family": "sans",
        "weight": "bold",
        "letterSpacing": "normal",
        "size": 1,
        "compact": 0,
        "leading": -2
      },
      "small-heading": {
        "family": "sans",
        "weight": "bold",
        "letterSpacing": "normal",
        "case": "none",
        "size": 0,
        "compact": -1,
        "leading": -1
      },
      "micro-heading": {
        "family": "sans",
        "weight": "bold",
        "letterSpacing": "normal",
        "case": "uppercase",
        "size": -1,
        "compact": -2,
        "leading": -3
      },
      "body-lg": {
        "size": 1,
        "compact": 0,
        "leading": -1
      },
      "body": {
        "family": "sans",
        "weight": "regular",
        "size": 0,
        "compact": -1,
        "leading": 0
      },
      "body-sm": {
        "size": -1,
        "compact": -2,
        "leading": -1
      },
      "body-xs": {
        "size": -2,
        "compact": -2,
        "leading": -2
      },
      "label": {
        "family": "sans",
        "weight": "bold",
        "size": 0,
        "sizeOnStyle": true,
        "compact": -1,
        "fluid": false,
        "leading": -1
      },
      "code": {
        "family": "mono",
        "weight": "regular"
      },
      "body-alt": {
        "family": "serif"
      },
      "body-strong": {
        "weight": "bold"
      }
    },
    "controls": {
      "control": {
        "size": 0,
        "leading": -2
      },
      "control-sm": {
        "size": -1,
        "leading": -2
      },
      "control-lg": {
        "size": 2,
        "leading": -2
      }
    }
  },
  "space": {
    "base": "1rem",
    "ratio": 1.333333,
    "roles": {
      "breathe-sm": {
        "from": "0.75rem",
        "step": 0
      },
      "breathe": {
        "step": 1
      },
      "cushion": {
        "step": 2
      },
      "cushion-lg": {
        "step": 3
      }
    },
    "site-width": "75rem",
    "targets": {
      "sm": 32,
      "default": 48,
      "lg": 64
    },
    "app": {
      "padding-inline": "cushion",
      "sidebar-width": 288,
      "sidebar-compact-width": 192
    }
  },
  "shape": {
    "radius": {
      "sm": 2,
      "md": 4,
      "lg": 8,
      "xl": 12,
      "default": "lg"
    },
    "border": {
      "thin": 1,
      "medium": 2,
      "thick": 4,
      "default": "thin"
    },
    "shadow": {
      "color": {
        "light": {
          "color": "neutral.900",
          "transparent": 90
        },
        "dark": {
          "color": "black",
          "transparent": 25
        }
      },
      "color-light": {
        "light": {
          "color": "neutral.800",
          "transparent": 95
        },
        "dark": {
          "color": "black",
          "transparent": 50
        }
      },
      "levels": {
        "sm": {
          "layers": [
            {
              "y": 0,
              "blur": 1,
              "spread": 0
            },
            {
              "y": 1,
              "blur": 2,
              "spread": 0
            },
            {
              "y": 2,
              "blur": 6,
              "spread": 0
            }
          ]
        },
        "md": {
          "layers": [
            {
              "y": 1,
              "blur": 4,
              "spread": 0
            },
            {
              "y": 2,
              "blur": 8,
              "spread": 0
            },
            {
              "y": 8,
              "blur": 24,
              "spread": 0
            }
          ]
        },
        "lg": {
          "layers": [
            {
              "y": 4,
              "blur": 16,
              "spread": 0
            },
            {
              "y": 8,
              "blur": 32,
              "spread": 0
            },
            {
              "y": 16,
              "blur": 64,
              "spread": 0
            }
          ]
        },
        "inner": {
          "inset": true,
          "layers": [
            {
              "y": 1,
              "blur": 2,
              "spread": 0
            },
            {
              "y": 2,
              "blur": 4,
              "spread": 0
            },
            {
              "y": 4,
              "blur": 8,
              "spread": 0
            }
          ]
        }
      }
    },
    "lines": {
      "rule": {
        "width": "thin",
        "color": "border.color.quiet",
        "style": "solid"
      },
      "panel": {
        "width": "thin",
        "color": "border.color.quiet",
        "style": "solid",
        "radius": "md"
      },
      "app": {
        "width": "thin",
        "color": "border.color.quiet",
        "style": "solid"
      },
      "control": {
        "width": "default",
        "color": "border.color.control"
      },
      "underline": {
        "width": "thin",
        "color": "color.muted",
        "offset": "thick"
      },
      "focus-ring": {
        "width": "medium",
        "color": "color.focus",
        "offset": "medium"
      }
    }
  },
  "components": {
    "brand.font-family": "{title.font-family}",
    "header.bg": "{surface.subtle}",
    "button.radius": "{radius.lg}",
    "sidebar.bg": "{surface.subtle}",
    "telemetry.radius": "{radius}",
    "poster.content-radius": "{radius.xl}",
    "footer.bg": "{surface.subtle}",
    "card.shadow": "{shadow.sm}",
    "card.border-width": "{border.width.none}",
    "poster.content-padding": "{spacing.cushion}",
    "footer.padding-block": "{spacing.cushion-lg}",
    "header.padding-block": "{spacing.breathe}",
    "button.icon-size": "1.2"
  },
  "mixes": {
    "color.muted": {
      "light": {
        "color": "currentColor",
        "transparent": 50
      },
      "dark": {
        "color": "currentColor",
        "transparent": 50
      }
    },
    "color.quiet": {
      "light": {
        "color": "currentColor",
        "transparent": 70
      },
      "dark": {
        "color": "currentColor",
        "transparent": 70
      }
    },
    "color.focus": {
      "light": {
        "color": "currentColor",
        "transparent": 0
      },
      "dark": {
        "color": "currentColor",
        "transparent": 0
      }
    },
    "color.backdrop": {
      "light": {
        "color": "neutral.900",
        "transparent": 50
      },
      "dark": {
        "color": "neutral.900",
        "transparent": 50
      }
    },
    "color.overlay": {
      "light": {
        "color": "neutral.000",
        "transparent": 33
      },
      "dark": {
        "color": "neutral.900",
        "transparent": 33
      }
    },
    "surface.layer": {
      "light": {
        "color": "white",
        "transparent": 10
      },
      "dark": {
        "color": "black",
        "transparent": 10
      }
    },
    "surface.translucent": {
      "light": {
        "color": "surface.inverted",
        "transparent": 95
      },
      "dark": {
        "color": "surface.inverted",
        "transparent": 95
      }
    },
    "surface.translucent-strong": {
      "light": {
        "color": "surface.inverted",
        "transparent": 90
      },
      "dark": {
        "color": "surface.inverted",
        "transparent": 90
      }
    },
    "surface.shade": {
      "light": {
        "color": "neutral.1000",
        "transparent": 95
      },
      "dark": {
        "color": "black",
        "transparent": 70
      }
    },
    "border.color.default": {
      "light": {
        "color": "currentColor",
        "transparent": 0
      },
      "dark": {
        "color": "currentColor",
        "transparent": 0
      }
    },
    "border.color.muted": {
      "light": {
        "color": "color.muted",
        "transparent": 0
      },
      "dark": {
        "color": "color.muted",
        "transparent": 0
      }
    },
    "border.color.quiet": {
      "light": {
        "color": "color.quiet",
        "transparent": 0
      },
      "dark": {
        "color": "color.quiet",
        "transparent": 0
      }
    },
    "border.color.control": {
      "light": {
        "color": "currentColor",
        "transparent": 33
      },
      "dark": {
        "color": "currentColor",
        "transparent": 33
      }
    }
  },
  "motion": {
    "duration": {
      "sm": 0.2,
      "md": 0.5,
      "lg": 1,
      "xl": 2
    },
    "ease": {
      "in-out": "cubic-bezier(0.4, 0.0, 0.2, 1)",
      "in": "cubic-bezier(0.4, 0.0, 1.0, 1.0)",
      "out": "cubic-bezier(0.0, 0.0, 0.2, 1)",
      "bounce": "cubic-bezier(0.68, -0.55, 0.27, 1.55)"
    }
  },
  "contrast": {
    "steps": 1,
    "extra": {
      "opacity.muted": "{opacity.90}"
    }
  }
}
