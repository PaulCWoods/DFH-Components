{
  "$description": "Starter: the library default. System fonts, a blue accent, and nothing to load.",
  "curve": "soft-s",
  "ends": {
    "light": 0.955,
    "dark": 0.27
  },
  "chroma": {
    "light": 0.45,
    "dark": 0.65
  },
  "fixed": {
    "white": "#ffffff",
    "black": "#121212"
  },
  "hues": {
    "neutral": {
      "seed": "#666666",
      "outside": {
        "1000": 0.04,
        "000": 0.02
      },
      "curve": "soft-s",
      "ends": {
        "light": 0.945
      }
    },
    "blue": {
      "seed": "#0000ff"
    },
    "purple": {
      "seed": "#9900ff"
    },
    "amber": {
      "seed": "#ffbb00"
    },
    "green": {
      "seed": "#00ff00"
    },
    "red": {
      "seed": "#ff0000"
    },
    "teal": {
      "seed": "#00ffff"
    }
  },
  "roles": {
    "surface.default": {
      "light": "neutral.000",
      "dark": "neutral.1000"
    },
    "surface.subtle": {
      "light": "neutral.000",
      "dark": "neutral.1000"
    },
    "surface.muted": {
      "light": "neutral.100",
      "dark": "neutral.900"
    },
    "surface.inverted": {
      "light": "neutral.1000",
      "dark": "neutral.000"
    },
    "surface.card": {
      "light": "white",
      "dark": "black"
    },
    "surface.card-inverted": {
      "light": "black",
      "dark": "white"
    },
    "surface.dark": {
      "light": "neutral.1000",
      "dark": "black"
    },
    "surface.darker": {
      "light": "black",
      "dark": "black"
    },
    "surface.accent": {
      "light": "blue.200",
      "dark": "blue.800"
    },
    "surface.accent-dark": {
      "light": "blue.800",
      "dark": "blue.800"
    },
    "surface.accent-strong": {
      "light": "blue.700",
      "dark": "blue.300"
    },
    "surface.complementary": {
      "light": "purple.200",
      "dark": "purple.800"
    },
    "surface.complementary-dark": {
      "light": "purple.800",
      "dark": "purple.800"
    },
    "surface.complementary-strong": {
      "light": "purple.700",
      "dark": "purple.300"
    },
    "surface.danger": {
      "light": "red.100",
      "dark": "red.900"
    },
    "surface.danger-strong": {
      "light": "red.700",
      "dark": "red.300"
    },
    "surface.warning": {
      "light": "amber.100",
      "dark": "amber.900"
    },
    "surface.info": {
      "light": "teal.100",
      "dark": "teal.900"
    },
    "surface.warning-strong": {
      "light": "amber.700",
      "dark": "amber.300"
    },
    "surface.info-strong": {
      "light": "teal.700",
      "dark": "teal.300"
    },
    "surface.success": {
      "light": "green.100",
      "dark": "green.900"
    },
    "surface.success-strong": {
      "light": "green.700",
      "dark": "green.300"
    },
    "foreground.default": {
      "light": "neutral.800",
      "dark": "neutral.000"
    },
    "foreground.strong": {
      "light": "black",
      "dark": "white"
    },
    "foreground.inverted": {
      "light": "neutral.000",
      "dark": "neutral.800"
    },
    "foreground.inverted-strong": {
      "light": "white",
      "dark": "black"
    },
    "foreground.on-dark": {
      "light": "neutral.000",
      "dark": "neutral.000"
    },
    "foreground.white": {
      "light": "white",
      "dark": "white"
    },
    "foreground.muted": {
      "light": "neutral.600",
      "dark": "neutral.400"
    },
    "foreground.accent": {
      "light": "blue.600",
      "dark": "blue.300"
    },
    "foreground.accent-hover": {
      "light": "blue.700",
      "dark": "blue.200"
    },
    "foreground.accent-pressed": {
      "light": "blue.800",
      "dark": "blue.100"
    },
    "foreground.complementary": {
      "light": "purple.700",
      "dark": "purple.300"
    },
    "foreground.complementary-hover": {
      "light": "purple.600",
      "dark": "purple.200"
    },
    "foreground.complementary-pressed": {
      "light": "purple.800",
      "dark": "purple.100"
    },
    "foreground.danger": {
      "light": "red.600",
      "dark": "red.300"
    },
    "foreground.danger-hover": {
      "light": "red.700",
      "dark": "red.200"
    },
    "foreground.danger-pressed": {
      "light": "red.800",
      "dark": "red.100"
    },
    "foreground.success": {
      "light": "green.600",
      "dark": "green.300"
    },
    "foreground.success-hover": {
      "light": "green.700",
      "dark": "green.200"
    },
    "foreground.success-pressed": {
      "light": "green.800",
      "dark": "green.100"
    },
    "foreground.warning": {
      "light": "amber.600",
      "dark": "amber.300"
    },
    "foreground.info": {
      "light": "teal.600",
      "dark": "teal.300"
    },
    "foreground.warning-hover": {
      "light": "amber.700",
      "dark": "amber.200"
    },
    "foreground.info-hover": {
      "light": "teal.700",
      "dark": "teal.200"
    },
    "foreground.warning-pressed": {
      "light": "amber.800",
      "dark": "amber.100"
    },
    "foreground.info-pressed": {
      "light": "teal.800",
      "dark": "teal.100"
    },
    "border.color.accent": {
      "light": "blue.500",
      "dark": "blue.500"
    },
    "border.color.complementary": {
      "light": "purple.600",
      "dark": "purple.500"
    },
    "border.color.danger": {
      "light": "red.500",
      "dark": "red.500"
    },
    "border.color.warning": {
      "light": "amber.500",
      "dark": "amber.500"
    },
    "border.color.info": {
      "light": "teal.500",
      "dark": "teal.500"
    },
    "border.color.success": {
      "light": "green.500",
      "dark": "green.500"
    }
