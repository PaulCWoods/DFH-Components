  "type": {
    "fonts": {},
    "families": {
      "sans": {
        "system": "sans-serif"
      },
      "serif": {
        "system": "serif"
      },
      "mono": {
        "system": "monospace"
      },
      "display": {
        "use": "sans"
      }
    },
    "scale": {
      "base": "1rem",
      "min": "0.75rem",
      "ratio": 1.2,
      "steps": [
        -2,
        8
      ]
    },
    "leading": {
      "base": 1.6,
      "ratio": 1.125,
      "steps": [
        -5,
        1
      ]
    },
    "fluid": {
      "viewports": [
        "25rem",
        "80rem"
      ],
      "max": {
        "base": "1.5rem",
        "ratio": 1.25
      }
    },
    "styles": {
      "display-title": {
        "family": "display",
        "weight": "heavy",
        "letterSpacing": "tight",
        "case": "none",
        "size": 8,
        "compact": 7,
        "leading": -4
      },
      "title": {
        "family": "display",
        "weight": "heavy",
        "letterSpacing": "normal",
        "case": "none",
        "size": 5,
        "compact": 4,
        "leading": -4
      },
      "heading": {
        "family": "sans",
        "weight": "bold",
        "letterSpacing": "normal",
        "case": "none",
        "size": 2,
        "compact": 1,
        "leading": -3
      },
      "subheading": {
        "family": "sans",
        "weight": "bold",
        "letterSpacing": "normal",
        "size": 1,
        "compact": 0,
        "leading": -2
      },
      "small-heading": {
        "family": "sans",
        "weight": "bold",
        "letterSpacing": "normal",
        "case": "none",
        "size": 0,
        "compact": -1,
        "leading": -1
      },
      "micro-heading": {
        "family": "sans",
        "weight": "bold",
        "letterSpacing": "normal",
        "case": "uppercase",
        "size": -1,
        "compact": -2,
        "leading": -3
      },
      "body-lg": {
        "size": 1,
        "compact": 0
      },
      "body": {
        "family": "sans",
        "weight": "regular",
        "size": 0,
        "compact": -1,
        "leading": 0
      },
      "body-sm": {
        "size": -1,
        "compact": -2,
        "leading": -1
      },
      "body-xs": {
        "size": -2,
        "compact": -2,
        "leading": -2
      },
      "label": {
        "family": "sans",
        "weight": "bold",
        "size": 0,
        "sizeOnStyle": true,
        "compact": -1,
        "fluid": false,
        "leading": -1
      },
      "code": {
        "family": "mono",
        "weight": "regular"
      },
      "body-alt": {
        "family": "serif"
      },
      "body-strong": {
        "weight": "bold"
      }
    },
    "controls": {
      "control": {
        "size": 0,
        "leading": -2
      },
      "control-sm": {
        "size": -1,
        "leading": -2
      },
      "control-lg": {
        "size": 2,
        "leading": -2
      }
    }
  },
  "space": {
    "base": "1rem",
    "ratio": 1.333333,
    "roles": {
      "breathe-sm": {
        "from": "0.75rem",
        "step": 0
      },
      "breathe": {
        "step": 1
      },
      "cushion": {
        "step": 2
      },
      "cushion-lg": {
        "step": 3
      }
    },
    "site-width": "75rem",
    "targets": {
      "sm": 32,
      "default": 48,
      "lg": 64
    }
  },
  "shape": {
    "radius": {
      "sm": 2,
      "md": 4,
      "lg": 8,
      "xl": 12,
      "default": "md"
    },
    "border": {
      "thin": 1,
      "medium": 2,
      "thick": 4,
      "default": "medium"
    },
    "shadow": {
      "color": {
        "light": {
          "color": "neutral.900",
          "transparent": 90
        },
        "dark": {
          "color": "black",
          "transparent": 25
        }
      },
      "color-light": {
        "light": {
          "color": "neutral.800",
          "transparent": 95
        },
        "dark": {
          "color": "black",
          "transparent": 50
        }
      },
      "levels": {
        "sm": {
          "layers": [
            {
              "y": 0,
              "blur": 1,
              "spread": 0
            },
            {
              "y": 1,
              "blur": 2,
              "spread": 0
            },
            {
              "y": 2,
              "blur": 6,
              "spread": 0
            }
          ]
        },
        "md": {
          "layers": [
            {
              "y": 1,
              "blur": 4,
              "spread": 0
            },
            {
              "y": 2,
              "blur": 8,
              "spread": 0
            },
            {
              "y": 8,
              "blur": 24,
              "spread": 0
            }
          ]
        },
        "lg": {
          "layers": [
            {
              "y": 4,
              "blur": 16,
              "spread": 0
            },
            {
              "y": 8,
              "blur": 32,
              "spread": 0
            },
            {
              "y": 16,
              "blur": 64,
              "spread": 0
            }
          ]
        },
        "inner": {
          "inset": true,
          "layers": [
            {
              "y": 1,
              "blur": 2,
              "spread": 0
            },
            {
              "y": 2,
              "blur": 4,
              "spread": 0
            },
            {
              "y": 4,
              "blur": 8,
              "spread": 0
            }
          ]
        }
      }
    },
    "lines": {
      "rule": {
        "width": "thin",
        "color": "border.color.quiet",
        "style": "solid"
      },
      "panel": {
        "width": "thin",
        "color": "border.color.quiet",
        "style": "solid",
        "radius": "md"
      },
      "app": {
        "width": "default",
        "color": "border.color.quiet",
        "style": "solid"
      },
      "control": {
        "width": "default",
        "color": "border.color.control"
      },
      "underline": {
        "width": "thin",
        "color": "color.muted",
        "offset": "thick"
      },
      "focus-ring": {
        "width": "medium",
        "color": "color.focus",
        "offset": "medium"
      }
    }
  },
  "components": {},
  "mixes": {
    "color.muted": {
      "light": {
        "color": "currentColor",
        "transparent": 50
      },
      "dark": {
        "color": "currentColor",
        "transparent": 50
      }
    },
    "color.quiet": {
      "light": {
        "color": "currentColor",
        "transparent": 70
      },
      "dark": {
        "color": "currentColor",
        "transparent": 70
      }
    },
    "color.focus": {
      "light": {
        "color": "currentColor",
        "transparent": 0
      },
      "dark": {
        "color": "currentColor",
        "transparent": 0
      }
    },
    "color.backdrop": {
      "light": {
        "color": "neutral.900",
        "transparent": 50
      },
      "dark": {
        "color": "neutral.900",
        "transparent": 50
      }
    },
    "color.overlay": {
      "light": {
        "color": "neutral.000",
        "transparent": 33
      },
      "dark": {
        "color": "neutral.900",
        "transparent": 33
      }
    },
    "surface.layer": {
      "light": {
        "color": "white",
        "transparent": 10
      },
      "dark": {
        "color": "black",
        "transparent": 10
      }
    },
    "surface.translucent": {
      "light": {
        "color": "surface.inverted",
        "transparent": 95
      },
      "dark": {
        "color": "surface.inverted",
        "transparent": 95
      }
    },
    "surface.translucent-strong": {
      "light": {
        "color": "surface.inverted",
        "transparent": 90
      },
      "dark": {
        "color": "surface.inverted",
        "transparent": 90
      }
    },
    "surface.shade": {
      "light": {
        "color": "neutral.1000",
        "transparent": 95
      },
      "dark": {
        "color": "black",
        "transparent": 70
      }
    },
    "border.color.default": {
      "light": {
        "color": "currentColor",
        "transparent": 0
      },
      "dark": {
        "color": "currentColor",
        "transparent": 0
      }
    },
    "border.color.muted": {
      "light": {
        "color": "color.muted",
        "transparent": 0
      },
      "dark": {
        "color": "color.muted",
        "transparent": 0
      }
    },
    "border.color.quiet": {
      "light": {
        "color": "color.quiet",
        "transparent": 0
      },
      "dark": {
        "color": "color.quiet",
        "transparent": 0
      }
    },
    "border.color.control": {
      "light": {
        "color": "currentColor",
        "transparent": 33
      },
      "dark": {
        "color": "currentColor",
        "transparent": 33
      }
    }
  },
  "motion": {
    "duration": {
      "sm": 0.2,
      "md": 0.5,
      "lg": 1,
      "xl": 2
    },
    "ease": {
      "in-out": "cubic-bezier(0.4, 0.0, 0.2, 1)",
      "in": "cubic-bezier(0.4, 0.0, 1.0, 1.0)",
      "out": "cubic-bezier(0.0, 0.0, 0.2, 1)",
      "bounce": "cubic-bezier(0.68, -0.55, 0.27, 1.55)"
    }
  },
  "contrast": {
    "steps": 1,
    "extra": {
      "opacity.muted": "{opacity.90}"
    }
  }
}
