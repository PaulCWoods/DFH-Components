{
  "$schema": "https://components.designforhumans.blog/schema/theme-v1.schema.json",
  "version": 1,
  "$description": "A sub-brand of dfh: class=\"theme-docs\".",
  "extends": "dfh",
  "hues": {
    "aqua": {
      "seed": "#119984"
    }
  },
  "roles": {
    "surface.complementary": {
      "light": "aqua.100",
      "dark": "aqua.900"
    },
    "surface.complementary-dark": {
      "light": "aqua.900",
      "dark": "aqua.900"
    },
    "surface.complementary-strong": {
      "light": "aqua.700",
      "dark": "aqua.300"
    },
    "foreground.complementary": {
      "light": "aqua.600",
      "dark": "aqua.300"
    },
    "foreground.complementary-hover": {
      "light": "aqua.700",
      "dark": "aqua.200"
    },
    "foreground.complementary-pressed": {
      "light": "aqua.800",
      "dark": "aqua.100"
    },
    "border.color.complementary": {
      "light": "aqua.600",
      "dark": "aqua.500"
    }
  },
  "type": {
    "styles": {
      "title": {
        "letterSpacing": "normal",
        "case": "none"
      }
    }
  },
  "shape": {
    "radius": {
      "sm": 2,
      "default": "md"
    },
    "lines": {
      "panel": {
        "width": "thin"
      }
    }
  }
}
