{
  "$description": "A course lesson in purple. A sub-brand of the course: class=\"theme-course-purple\".",
  "extends": "course",
  "roles": {
    "surface.accent": {
      "light": "purple.200",
      "dark": "purple.800"
    },
    "surface.accent-dark": {
      "light": "purple.800",
      "dark": "purple.800"
    },
    "surface.accent-strong": {
      "light": "purple.700",
      "dark": "purple.300"
    },
    "foreground.accent": {
      "light": "purple.600",
      "dark": "purple.300"
    },
    "foreground.accent-hover": {
      "light": "purple.700",
      "dark": "purple.200"
    },
    "foreground.accent-pressed": {
      "light": "purple.800",
      "dark": "purple.100"
    },
    "border.color.accent": {
      "light": "purple.500",
      "dark": "purple.500"
    }
  }
