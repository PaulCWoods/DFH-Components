{
  "$schema": "https://components.designforhumans.blog/schema/theme-v1.schema.json",
  "version": 1,
  "$description": "The theme the colour tokens are built from. Edit this (or use the Token Designer), then run npm run build:palette; add -- --write to update tokens/1-global.json and tokens/2-semantic.json. Each hue starts from a picked colour: its hue and chroma make the 500 step, and a lightness curve (a CSS easing: linear, s, soft-s, reverse-s, ease-in, ease-out or cubic-bezier(x1, y1, x2, y2)) runs from the light end (100) to the dark end (900). A hue may set its own curve, ends and chroma, and exact: true keeps its picked colour itself as its 500, bending the curve through that colour's lightness (off by default, so the 500 follows the curve); outside adds steps beyond the ends (neutral's 000 is that much lighter than its 100, its 1000 that much darker than its 900), so they follow the ends. fixed sets white and black, which aren't ramps. neutral, red, amber and green are required; other hues take any lower-case name. roles gives each Tier 2 colour role a palette colour for light mode and one for dark (hue.step, white or black).",
  "curve": "soft-s",
  "ends": {
    "light": 0.955,
    "dark": 0.27
  },
  "chroma": {
    "light": 0.45,
    "dark": 0.65
  },
  "fixed": {
    "white": "#ffffff",
    "black": "#181716"
  },
  "hues": {
    "neutral": {
      "seed": "#8a8984",
      "outside": {
        "1000": 0.04,
        "000": 0.02
      },
      "curve": "soft-s",
      "ends": {
        "light": 0.945
      }
    },
    "blue": {
      "seed": "#379fd7"
    },
    "purple": {
      "seed": "#ad77e1"
    },
    "amber": {
      "seed": "#ffa300"
    },
    "green": {
      "seed": "#56a900"
    },
    "red": {
      "seed": "#ff2e25"
    }
  },
  "roles": {
    "surface.default": {
      "light": "neutral.000",
      "dark": "neutral.1000"
    },
    "surface.subtle": {
      "light": "neutral.000",
      "dark": "neutral.1000"
    },
    "surface.muted": {
      "light": "neutral.100",
      "dark": "neutral.900"
    },
    "surface.inverted": {
      "light": "neutral.1000",
      "dark": "neutral.000"
    },
    "surface.card": {
      "light": "white",
      "dark": "black"
    },
    "surface.card-inverted": {
      "light": "black",
      "dark": "white"
    },
    "surface.dark": {
      "light": "neutral.1000",
      "dark": "black"
    },
    "surface.darker": {
      "light": "black",
      "dark": "black"
    },
    "surface.accent": {
      "light": "purple.100",
      "dark": "purple.900"
    },
    "surface.accent-dark": {
      "light": "purple.900",
      "dark": "purple.900"
    },
    "surface.accent-strong": {
      "light": "purple.700",
      "dark": "purple.300"
    },
    "surface.complementary": {
      "light": "blue.100",
      "dark": "blue.900"
    },
    "surface.complementary-dark": {
      "light": "blue.900",
      "dark": "blue.900"
    },
    "surface.complementary-strong": {
      "light": "blue.700",
      "dark": "blue.300"
    },
    "surface.danger": {
      "light": "red.100",
      "dark": "red.900"
    },
    "surface.danger-strong": {
      "light": "red.700",
      "dark": "red.300"
    },
    "surface.warning": {
      "light": "amber.100",
      "dark": "amber.900"
    },
    "surface.info": {
      "light": "blue.100",
      "dark": "blue.900"
    },
    "surface.warning-strong": {
      "light": "amber.700",
      "dark": "amber.300"
    },
    "surface.info-strong": {
      "light": "blue.700",
      "dark": "blue.300"
    },
    "surface.success": {
      "light": "green.100",
      "dark": "green.900"
    },
    "surface.success-strong": {
      "light": "green.700",
      "dark": "green.300"
    },
    "foreground.default": {
      "light": "neutral.800",
      "dark": "neutral.000"
    },
    "foreground.strong": {
      "light": "black",
      "dark": "white"
    },
    "foreground.inverted": {
      "light": "neutral.000",
      "dark": "neutral.800"
    },
    "foreground.inverted-strong": {
      "light": "white",
      "dark": "black"
    },
    "foreground.on-dark": {
      "light": "neutral.000",
      "dark": "neutral.000"
    },
    "foreground.white": {
      "light": "white",
      "dark": "white"
    },
    "foreground.muted": {
      "light": "neutral.600",
      "dark": "neutral.400"
    },
    "foreground.accent": {
      "light": "purple.600",
      "dark": "purple.300"
    },
    "foreground.accent-hover": {
      "light": "purple.700",
      "dark": "purple.200"
    },
    "foreground.accent-pressed": {
      "light": "purple.800",
      "dark": "purple.100"
    },
    "foreground.complementary": {
      "light": "blue.600",
      "dark": "blue.300"
    },
    "foreground.complementary-hover": {
      "light": "blue.700",
      "dark": "blue.200"
    },
    "foreground.complementary-pressed": {
      "light": "blue.800",
      "dark": "blue.100"
    },
    "foreground.danger": {
      "light": "red.600",
      "dark": "red.300"
    },
    "foreground.danger-hover": {
      "light": "red.700",
      "dark": "red.200"
    },
    "foreground.danger-pressed": {
      "light": "red.800",
      "dark": "red.100"
    },
    "foreground.success": {
      "light": "green.600",
      "dark": "green.300"
    },
    "foreground.success-hover": {
      "light": "green.700",
      "dark": "green.200"
    },
    "foreground.success-pressed": {
      "light": "green.800",
      "dark": "green.100"
    },
    "foreground.warning": {
      "light": "amber.600",
      "dark": "amber.300"
    },
    "foreground.info": {
      "light": "blue.600",
      "dark": "blue.300"
    },
    "foreground.warning-hover": {
      "light": "amber.700",
      "dark": "amber.200"
    },
    "foreground.info-hover": {
      "light": "blue.700",
      "dark": "blue.200"
    },
    "foreground.warning-pressed": {
      "light": "amber.800",
      "dark": "amber.100"
    },
    "foreground.info-pressed": {
      "light": "blue.800",
      "dark": "blue.100"
    },
    "border.color.accent": {
      "light": "purple.500",
      "dark": "purple.500"
    },
    "border.color.complementary": {
      "light": "blue.600",
      "dark": "blue.500"
    },
    "border.color.danger": {
      "light": "red.500",
      "dark": "red.500"
    },
    "border.color.warning": {
      "light": "amber.500",
      "dark": "amber.500"
    },
    "border.color.info": {
      "light": "blue.500",
      "dark": "blue.500"
    },
    "border.color.success": {
      "light": "green.500",
      "dark": "green.500"
    }
  },
  "type": {
    "fonts": {
      "adapter-sans": {
        "source": "adobe",
        "family": "adapter-pe-variable",
        "axes": {
          "wght": [
            100,
            900
          ]
        },
        "italicAxes": {
          "ital": 1,
          "slnt": -10
        },
        "kit": "lrj6kun",
        "fallback": "system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
        "figma": "Adapter PE Variable"
      },
      "mencken": {
        "source": "adobe",
        "family": "mencken-std-text",
        "weights": [
          400,
          700
        ],
        "kit": "lrj6kun",
        "fallback": "Cambria, \"Times New Roman\", Times, serif",
        "figma": "Mencken Std Text"
      },
      "pt-mono": {
        "source": "adobe",
        "family": "adapter-mono-pe-variable",
        "axes": {
          "wght": [
            100,
            900
          ]
        },
        "kit": "lrj6kun",
        "fallback": "Menlo, Monaco, Consolas, \"Liberation Mono\", \"Courier New\", monospace"
      },
      "avory": {
        "source": "adobe",
        "family": "avory-i-pe",
        "weights": [
          800
        ],
        "kit": "lrj6kun",
        "fallback": "\"Inter\", system-ui, -apple-system, sans-serif",
        "figma": "Avory I PE"
      }
    },
    "families": {
      "sans": {
        "font": "adapter-sans"
      },
      "serif": {
        "font": "mencken"
      },
      "mono": {
        "font": "pt-mono"
      },
      "display": {
        "font": "avory"
      }
    },
    "scale": {
      "base": "1rem",
      "min": "0.75rem",
      "ratio": 1.2,
      "steps": [
        -2,
        8
      ],
      "ceiling": {
        "lower": "4.25rem",
        "upper": "9rem"
      }
    },
    "leading": {
      "base": 1.6,
      "ratio": 1.125,
      "steps": [
        -5,
        1
      ]
    },
    "fluid": {
      "viewports": [
        "25rem",
        "75rem"
      ],
      "max": {
        "base": "1.5rem",
        "ratio": 1.25
      }
    },
    "styles": {
      "display-title": {
        "family": "display",
        "weight": "heavy",
        "letterSpacing": "xtight",
        "case": "uppercase",
        "size": 8,
        "compact": 6,
        "leading": -4
      },
      "title": {
        "family": "display",
        "weight": "heavy",
        "letterSpacing": "tight",
        "case": "uppercase",
        "size": 6,
        "compact": 4,
        "leading": -4
      },
      "heading": {
        "family": "sans",
        "weight": "bold",
        "letterSpacing": "normal",
        "case": "none",
        "size": 2,
        "compact": 1,
        "leading": -3
      },
      "subheading": {
        "family": "sans",
        "weight": "bold",
        "letterSpacing": "normal",
        "size": 1,
        "compact": 0,
        "leading": -3
      },
      "small-heading": {
        "family": "sans",
        "weight": "bold",
        "letterSpacing": "normal",
        "case": "none",
        "size": 0,
        "compact": -1,
        "leading": -3
      },
      "micro-heading": {
        "family": "sans",
        "weight": "bold",
        "letterSpacing": "normal",
        "case": "uppercase",
        "size": -1,
        "compact": -2,
        "leading": -3
      },
      "body-lg": {
        "size": 1,
        "compact": 0
      },
      "body": {
        "family": "sans",
        "weight": "medium",
        "size": 0,
        "compact": -1,
        "leading": 0
      },
      "body-sm": {
        "size": -1,
        "compact": -2,
        "leading": -1
      },
      "body-xs": {
        "size": -2,
        "compact": -2,
        "leading": -2
      },
      "label": {
        "family": "sans",
        "weight": "bold",
        "size": 0,
        "sizeOnStyle": true,
        "compact": -1,
        "fluid": false,
        "leading": -1
      },
      "code": {
        "family": "mono",
        "weight": "medium"
      },
      "body-alt": {
        "family": "serif",
        "weight": "regular"
      },
      "body-strong": {
        "weight": "bold"
      }
    },
    "controls": {
      "control": {
        "size": 0,
        "leading": -2
      },
      "control-sm": {
        "size": -1,
        "leading": -2
      },
      "control-lg": {
        "size": 2,
        "leading": -2
      }
    }
  },
  "space": {
    "base": "1rem",
    "ratio": 1.333333,
    "roles": {
      "breathe-sm": {
        "from": "0.75rem",
        "step": 0
      },
      "breathe": {
        "step": 1
      },
      "cushion": {
        "step": 2
      },
      "cushion-lg": {
        "step": 3
      }
    },
    "site-width": "75rem",
    "targets": {
      "sm": 32,
      "default": 48,
      "lg": 64
    },
    "app": {
      "padding-inline": "cushion",
      "sidebar-width": 288,
      "sidebar-compact-width": 192
    }
  },
  "shape": {
    "radius": {
      "sm": 0,
      "md": 4,
      "lg": 8,
      "xl": 12,
      "default": "none"
    },
    "border": {
      "thin": 1,
      "medium": 2,
      "thick": 4,
      "default": "medium"
    },
    "shadow": {
      "color": {
        "light": {
          "color": "neutral.900",
          "transparent": 90
        },
        "dark": {
          "color": "black",
          "transparent": 33
        }
      },
      "color-light": {
        "light": {
          "color": "neutral.800",
          "transparent": 95
        },
        "dark": {
          "color": "black",
          "transparent": 50
        }
      },
      "levels": {
        "sm": {
          "layers": [
            {
              "y": 0,
              "blur": 1,
              "spread": 0
            },
            {
              "y": 1,
              "blur": 2,
              "spread": 0
            },
            {
              "y": 2,
              "blur": 6,
              "spread": 0
            }
          ]
        },
        "md": {
          "layers": [
            {
              "y": 1,
              "blur": 4,
              "spread": 0
            },
            {
              "y": 2,
              "blur": 8,
              "spread": 0
            },
            {
              "y": 8,
              "blur": 24,
              "spread": 0
            }
          ]
        },
        "lg": {
          "layers": [
            {
              "y": 4,
              "blur": 16,
              "spread": 0
            },
            {
              "y": 8,
              "blur": 32,
              "spread": 0
            },
            {
              "y": 16,
              "blur": 64,
              "spread": 0
            }
          ]
        },
        "inner": {
          "inset": true,
          "layers": [
            {
              "y": 1,
              "blur": 2,
              "spread": 0
            },
            {
              "y": 2,
              "blur": 4,
              "spread": 0
            },
            {
              "y": 4,
              "blur": 8,
              "spread": 0
            }
          ]
        }
      }
    },
    "lines": {
      "rule": {
        "width": "thin",
        "color": "border.color.quiet",
        "style": "solid"
      },
      "panel": {
        "width": "none",
        "color": "border.color.quiet",
        "style": "solid",
        "radius": "default"
      },
      "app": {
        "width": "default",
        "color": "border.color.quiet",
        "style": "solid"
      },
      "control": {
        "width": "default",
        "color": "border.color.control"
      },
      "underline": {
        "width": "thin",
        "color": "color.muted",
        "offset": "thick"
      },
      "focus-ring": {
        "width": "medium",
        "color": "color.focus",
        "offset": "medium"
      }
    }
  },
  "components": {
    "accordion.border-width": "{border.width.thin}",
    "accordion.border-style": "dashed",
    "accordion.border-color": "{border.color.quiet}",
    "accordion.radius": "{radius}",
    "brand.font-weight": "{font-weight.bold}",
    "header.bg": "{surface.subtle}",
    "footer.bg": "{surface.subtle}",
    "sidebar.bg": "{surface.subtle}"
  },
  "mixes": {
    "color.muted": {
      "light": {
        "color": "currentColor",
        "transparent": 33
      },
      "dark": {
        "color": "currentColor",
        "transparent": 33
      }
    },
    "color.quiet": {
      "light": {
        "color": "currentColor",
        "transparent": 70
      },
      "dark": {
        "color": "currentColor",
        "transparent": 70
      }
    },
    "color.focus": {
      "light": {
        "color": "currentColor",
        "transparent": 0
      },
      "dark": {
        "color": "currentColor",
        "transparent": 0
      }
    },
    "color.backdrop": {
      "light": {
        "color": "neutral.900",
        "transparent": 50
      },
      "dark": {
        "color": "neutral.900",
        "transparent": 50
      }
    },
    "color.overlay": {
      "light": {
        "color": "neutral.000",
        "transparent": 33
      },
      "dark": {
        "color": "neutral.900",
        "transparent": 33
      }
    },
    "surface.layer": {
      "light": {
        "color": "white",
        "transparent": 10
      },
      "dark": {
        "color": "black",
        "transparent": 10
      }
    },
    "surface.translucent": {
      "light": {
        "color": "surface.inverted",
        "transparent": 95
      },
      "dark": {
        "color": "surface.inverted",
        "transparent": 95
      }
    },
    "surface.translucent-strong": {
      "light": {
        "color": "surface.inverted",
        "transparent": 90
      },
      "dark": {
        "color": "surface.inverted",
        "transparent": 90
      }
    },
    "surface.shade": {
      "light": {
        "color": "neutral.1000",
        "transparent": 95
      },
      "dark": {
        "color": "black",
        "transparent": 70
      }
    },
    "border.color.default": {
      "light": {
        "color": "currentColor",
        "transparent": 0
      },
      "dark": {
        "color": "currentColor",
        "transparent": 0
      }
    },
    "border.color.muted": {
      "light": {
        "color": "color.muted",
        "transparent": 0
      },
      "dark": {
        "color": "color.muted",
        "transparent": 0
      }
    },
    "border.color.quiet": {
      "light": {
        "color": "color.quiet",
        "transparent": 0
      },
      "dark": {
        "color": "color.quiet",
        "transparent": 0
      }
    },
    "border.color.control": {
      "light": {
        "color": "currentColor",
        "transparent": 33
      },
      "dark": {
        "color": "currentColor",
        "transparent": 33
      }
    }
  },
  "motion": {
    "duration": {
      "sm": 0.2,
      "md": 0.5,
      "lg": 1,
      "xl": 2
    },
    "ease": {
      "in-out": "cubic-bezier(0.4, 0.0, 0.2, 1)",
      "in": "cubic-bezier(0.4, 0.0, 1.0, 1.0)",
      "out": "cubic-bezier(0.0, 0.0, 0.2, 1)",
      "bounce": "cubic-bezier(0.68, -0.55, 0.27, 1.55)"
    }
  },
  "contrast": {
    "steps": 1,
    "extra": {
      "opacity.muted": "{opacity.90}"
    }
  }
}
