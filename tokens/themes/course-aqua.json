{
  "$schema": "https://components.designforhumans.blog/schema/theme-v1.schema.json",
  "version": 1,
  "$description": "A course lesson in aqua. A sub-brand of the course: class=\"theme-course-aqua\".",
  "extends": "course",
  "hues": {
    "aqua": {
      "seed": "#119984"
    }
  },
  "roles": {
    "surface.accent": {
      "light": "aqua.100",
      "dark": "aqua.900"
    },
    "surface.accent-dark": {
      "light": "aqua.900",
      "dark": "aqua.900"
    },
    "surface.accent-strong": {
      "light": "aqua.700",
      "dark": "aqua.300"
    },
    "foreground.accent": {
      "light": "aqua.600",
      "dark": "aqua.300"
    },
    "foreground.accent-hover": {
      "light": "aqua.700",
      "dark": "aqua.200"
    },
    "foreground.accent-pressed": {
      "light": "aqua.800",
      "dark": "aqua.100"
    },
    "border.color.accent": {
      "light": "aqua.500",
      "dark": "aqua.500"
    }
  }
}
